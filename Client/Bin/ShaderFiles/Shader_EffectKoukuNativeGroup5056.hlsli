    r0.x = ((r0.xxxx)*(source[0].xxxx)).x;
    // 29: movc r0.x, r0.y, l(0), r0.x
    r0.x = ((asuint(r0.yyyy) != 0u) ? (float4(asfloat(0u),asfloat(0u),asfloat(0u),asfloat(0u))) : (r0.xxxx)).x;
    // 30: mul r0.yzw, r1.yyzw, cb0[2].xxxx
    r0.yzw = ((r1.yyzw)*(source[2].xxxx)).yzw;
    // 31: dp3 r1.x, r0.yzwy, l(0.300000, 0.590000, 0.110000, 0.000000)
    r1.x = (dot((r0.yzwy).xyz,(float4(0.300000,0.590000,0.110000,0.000000)).xyz).xxxx).x;
    // 32: mad r1.xyz, -cb0[2].xxxx, r1.yzwy, r1.xxxx
    r1.xyz = ((-(source[2].xxxx))*(r1.yzwy)+(r1.xxxx)).xyz;
    // 33: mad r0.yzw, cb0[2].yyyy, r1.xxyz, r0.yyzw
    r0.yzw = ((source[2].yyyy)*(r1.xxyz)+(r0.yyzw)).yzw;
    // 34: mad r0.yzw, r0.yyzw, v3.xxyz, cb0[1].xxyz
    r0.yzw = ((r0.yyzw)*(v3.xxyz)+(source[1].xxyz)).yzw;
    // 35: mul r0.yzw, r0.yyzw, v5.wwww
    r0.yzw = ((r0.yyzw)*(v5.wwww)).yzw;
    // 36: mul o0.xyz, r0.xxxx, r0.yzwy
    output.xyz = ((r0.xxxx)*(r0.yzwy)).xyz;
    // 37: mov o0.w, l(0)
    output.w = (float4(asfloat(0u),asfloat(0u),asfloat(0u),asfloat(0u))).w;
    return output;
}
