    r0.x = (SourceCharacterBitInsert(uint4(5u,5u,5u,5u),uint4(0u,0u,0u,0u),asuint(r0.xxxx),uint4(32u,32u,32u,32u))).x;
    // 185: utof r0.x, r0.x
    r0.x = ((float4)(asuint(r0.xxxx))).x;
