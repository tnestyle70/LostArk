{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lostark.local/schemas/lostark.valtan-bounded-weapon-trail-drawable-proof.schema.json",
  "title": "Valtan bounded weapon Trail drawable proof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "formatVersion",
    "bossArchetypeId",
    "classification",
    "reconstructionPolicy",
    "candidateManifest",
    "runtimeSweep",
    "sourceCanary",
    "modelEvidence",
    "targets",
    "summary",
    "disposition",
    "artifactSha256"
  ],
  "properties": {
    "schema": { "const": "lostark.valtan-bounded-weapon-trail-drawable-proof" },
    "formatVersion": { "const": 1 },
    "bossArchetypeId": { "const": "BOSS_VALTAN" },
    "classification": { "const": "PROJECT_TUNED" },
    "reconstructionPolicy": { "const": "BOUNDED_RECONSTRUCTION" },
    "candidateManifest": { "$ref": "#/$defs/sealedArtifact" },
    "runtimeSweep": { "$ref": "#/$defs/runtimeSweep" },
    "sourceCanary": { "$ref": "#/$defs/sourceCanary" },
    "modelEvidence": { "$ref": "#/$defs/modelEvidence" },
    "targets": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/target" }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "disposition": { "const": "DRAWABLE_PROOF_PASS" },
    "artifactSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$)).+$"
    },
    "string": { "type": "string", "minLength": 1 },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "shaArray3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "stringArray3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/string" }
    },
    "sealedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "rawSha256", "artifactSha256"],
      "properties": {
        "path": { "$ref": "#/$defs/repositoryPath" },
        "rawSha256": { "$ref": "#/$defs/sha256" },
        "artifactSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "runtimeSweep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "rawSha256", "resourceRoot"],
      "properties": {
        "path": { "$ref": "#/$defs/repositoryPath" },
        "rawSha256": { "$ref": "#/$defs/sha256" },
        "resourceRoot": { "$ref": "#/$defs/string" }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "slotIds", "byteSize", "sha256"],
      "properties": {
        "assetId": { "$ref": "#/$defs/repositoryPath" },
        "slotIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": ["base", "noise", "mask", "dissolve"]
          }
        },
        "byteSize": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sourceCanary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "familyName",
        "documentPath",
        "documentRawSha256",
        "documentCanonicalSha256",
        "elementIds",
        "elementSha256",
        "resourceClosureSha256",
        "materialClosureSha256",
        "trailGeometrySha256",
        "resources"
      ],
      "properties": {
        "familyName": { "const": "FX_BS_01.Trail.Par_N_MRHG_Trail_01" },
        "documentPath": {
          "const": "Data/Effects/Authored/effect.valtan.pattern.420633.active.effect.json"
        },
        "documentRawSha256": { "$ref": "#/$defs/sha256" },
        "documentCanonicalSha256": { "$ref": "#/$defs/sha256" },
        "elementIds": { "$ref": "#/$defs/stringArray3" },
        "elementSha256": { "$ref": "#/$defs/shaArray3" },
        "resourceClosureSha256": { "$ref": "#/$defs/shaArray3" },
        "materialClosureSha256": { "$ref": "#/$defs/shaArray3" },
        "trailGeometrySha256": { "$ref": "#/$defs/shaArray3" },
        "resources": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": { "$ref": "#/$defs/resource" }
        }
      }
    },
    "modelEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceAnchorSlotId",
        "runtimeModelAssetId",
        "runtimeBoneName",
        "boneIndex",
        "boneNameHash",
        "matchPolicy",
        "modelSha256",
        "admission",
        "parentBoneIndex",
        "runtimeAnchorSlots"
      ],
      "properties": {
        "sourceAnchorSlotId": { "const": "b_wp_r_01" },
        "runtimeModelAssetId": {
          "const": "Character/Valtan/MN_RPBF_01.wmodel"
        },
        "runtimeBoneName": { "const": "b_wp_r_01" },
        "boneIndex": { "const": 54 },
        "boneNameHash": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "matchPolicy": { "const": "EXACT_CASE_SENSITIVE" },
        "modelSha256": { "$ref": "#/$defs/sha256" },
        "admission": { "const": "ADMITTED_EXPLICIT_RUNTIME_BONE" },
        "parentBoneIndex": { "type": "integer", "minimum": 0 },
        "runtimeAnchorSlots": { "$ref": "#/$defs/stringArray3" }
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preparedSamples",
        "attemptedSamples",
        "submittedDraws",
        "suppressedDraws",
        "failedDraws",
        "committedDraws",
        "transactionCommitted"
      ],
      "properties": {
        "preparedSamples": { "type": "integer", "minimum": 0 },
        "attemptedSamples": { "type": "integer", "minimum": 0 },
        "submittedDraws": { "type": "integer", "minimum": 0 },
        "suppressedDraws": { "type": "integer", "minimum": 0 },
        "failedDraws": { "type": "integer", "minimum": 0 },
        "committedDraws": { "type": "integer", "minimum": 0 },
        "transactionCommitted": { "type": "boolean" }
      }
    },
    "positiveMovingBone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerSampleCount",
        "rootWorldDistinctCount",
        "anchorWorldDistinctCount",
        "trailPointCount",
        "distinctTrailPointCount",
        "finiteTrailPointCount",
        "cumulativeDistance",
        "firstWorldPosition",
        "lastWorldPosition",
        "renderer"
      ],
      "properties": {
        "providerSampleCount": { "type": "integer", "minimum": 2 },
        "rootWorldDistinctCount": { "const": 1 },
        "anchorWorldDistinctCount": { "type": "integer", "minimum": 2 },
        "trailPointCount": { "type": "integer", "minimum": 2 },
        "distinctTrailPointCount": { "type": "integer", "minimum": 2 },
        "finiteTrailPointCount": { "type": "integer", "minimum": 2 },
        "cumulativeDistance": { "type": "number", "minimum": 0 },
        "firstWorldPosition": { "$ref": "#/$defs/vec3" },
        "lastWorldPosition": { "$ref": "#/$defs/vec3" },
        "renderer": { "$ref": "#/$defs/renderer" }
      }
    },
    "stationaryControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerSampleCount",
        "rootWorldDistinctCount",
        "anchorWorldDistinctCount",
        "trailPointCount",
        "distinctTrailPointCount",
        "renderer",
        "segmentSuppressed"
      ],
      "properties": {
        "providerSampleCount": { "type": "integer", "minimum": 2 },
        "rootWorldDistinctCount": { "const": 1 },
        "anchorWorldDistinctCount": { "const": 1 },
        "trailPointCount": { "type": "integer", "minimum": 0, "maximum": 1 },
        "distinctTrailPointCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "renderer": { "$ref": "#/$defs/renderer" },
        "segmentSuppressed": { "const": true }
      }
    },
    "missingAnchorControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerRejected",
        "playbackStatePreserved",
        "trailPointCountAfterReject",
        "status"
      ],
      "properties": {
        "providerRejected": { "const": true },
        "playbackStatePreserved": { "const": true },
        "trailPointCountAfterReject": { "const": 0 },
        "status": { "$ref": "#/$defs/string" }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elementId",
        "positiveMovingBone",
        "stationaryControl",
        "initialElementSha256",
        "protectedElementContractSha256",
        "resourceClosureSha256",
        "materialClosureSha256",
        "trailGeometrySha256"
      ],
      "properties": {
        "elementId": { "$ref": "#/$defs/string" },
        "positiveMovingBone": { "$ref": "#/$defs/positiveMovingBone" },
        "stationaryControl": { "$ref": "#/$defs/stationaryControl" },
        "initialElementSha256": { "$ref": "#/$defs/sha256" },
        "protectedElementContractSha256": { "$ref": "#/$defs/sha256" },
        "resourceClosureSha256": { "$ref": "#/$defs/sha256" },
        "materialClosureSha256": { "$ref": "#/$defs/sha256" },
        "trailGeometrySha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patternId",
        "stageId",
        "effectAssetId",
        "candidatePath",
        "candidateRawSha256",
        "candidateCanonicalSha256",
        "candidateTypedCodecSha256",
        "runtimeAnchorSlotId",
        "runtimeBoneName",
        "sourceStartSeconds",
        "sourceDurationSeconds",
        "elements",
        "missingAnchorControl",
        "disposition"
      ],
      "properties": {
        "patternId": {
          "enum": [
            "VALTAN_WHIRLWIND",
            "VALTAN_GROUND_WAVE_SMASH",
            "VALTAN_JUMP_SPIN"
          ]
        },
        "stageId": { "enum": ["RECOVERY", "WINDUP"] },
        "effectAssetId": {
          "enum": [
            "effect.valtan.whirlwind.recovery",
            "effect.valtan.ground-wave-smash.windup",
            "effect.valtan.jump-spin.recovery"
          ]
        },
        "candidatePath": { "$ref": "#/$defs/repositoryPath" },
        "candidateRawSha256": { "$ref": "#/$defs/sha256" },
        "candidateCanonicalSha256": { "$ref": "#/$defs/sha256" },
        "candidateTypedCodecSha256": { "$ref": "#/$defs/sha256" },
        "runtimeAnchorSlotId": {
          "enum": [
            "VALTAN_WHIRLWIND_RECOVERY_WEAPON_R",
            "VALTAN_GROUND_WAVE_SMASH_WINDUP_WEAPON_R",
            "VALTAN_JUMP_SPIN_RECOVERY_WEAPON_R"
          ]
        },
        "runtimeBoneName": { "const": "b_wp_r_01" },
        "sourceStartSeconds": { "type": "number", "minimum": 0 },
        "sourceDurationSeconds": { "type": "number", "minimum": 0 },
        "elements": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/element" }
        },
        "missingAnchorControl": { "$ref": "#/$defs/missingAnchorControl" },
        "disposition": { "const": "DRAWABLE_PROOF_PASS" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetCount",
        "candidateElementCount",
        "movingBoneDrawableCount",
        "stationarySuppressedCount",
        "missingAnchorRollbackCount",
        "failedDrawCount"
      ],
      "properties": {
        "targetCount": { "const": 3 },
        "candidateElementCount": { "const": 9 },
        "movingBoneDrawableCount": { "const": 9 },
        "stationarySuppressedCount": { "const": 9 },
        "missingAnchorRollbackCount": { "const": 3 },
        "failedDrawCount": { "const": 0 }
      }
    }
  }
}
