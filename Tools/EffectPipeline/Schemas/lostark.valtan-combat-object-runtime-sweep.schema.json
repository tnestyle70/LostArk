{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lostark.local/schemas/lostark.valtan-combat-object-runtime-sweep.schema.json",
  "title": "Valtan combat-object WARP drawable runtime sweep",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "formatVersion",
    "bossArchetypeId",
    "renderer",
    "resourceRoot",
    "bossCatalog",
    "combatObjectCatalog",
    "existingLifecycleHarness",
    "targets",
    "ownerLifetimeBoundary",
    "disposition"
  ],
  "properties": {
    "schema": { "const": "lostark.valtan-combat-object-runtime-sweep" },
    "formatVersion": { "const": 1 },
    "bossArchetypeId": { "const": "BOSS_VALTAN" },
    "renderer": { "$ref": "#/$defs/renderer" },
    "resourceRoot": { "type": "string", "minLength": 1 },
    "bossCatalog": { "$ref": "#/$defs/inputIdentity" },
    "combatObjectCatalog": { "$ref": "#/$defs/inputIdentity" },
    "existingLifecycleHarness": { "$ref": "#/$defs/lifecycle" },
    "targets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/target" }
    },
    "ownerLifetimeBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "combatObjectArchetypeId",
        "seconds",
        "rendererSampleAttempted",
        "stopAppliedByExistingLifecycleHarness"
      ],
      "properties": {
        "combatObjectArchetypeId": {
          "const": "combatobject.valtan.high-jump.target-axe"
        },
        "seconds": { "const": 1.9 },
        "rendererSampleAttempted": { "const": false },
        "stopAppliedByExistingLifecycleHarness": { "const": true }
      }
    },
    "disposition": { "const": "DRAWABLE_PROOF_PASS" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["driver", "vendorId", "deviceId"],
      "properties": {
        "driver": { "const": "D3D_DRIVER_TYPE_WARP" },
        "vendorId": { "const": 5140 },
        "deviceId": { "const": 140 }
      }
    },
    "inputIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "rawSha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "rawSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "assertionCount", "failureCount", "facts"],
      "properties": {
        "mode": { "const": "--valtan-combat-object-presentation-fast" },
        "assertionCount": { "const": 9 },
        "failureCount": { "const": 0 },
        "facts": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "prefixItems": [
            { "const": "LATE_INITIAL_AGE_RESOLUTION" },
            { "const": "STOP_ONCE" },
            { "const": "ATOMIC_SNAPSHOT_ROLLBACK" },
            { "const": "BOUNDED_THREE_ATTEMPT_RETRY" },
            { "const": "UPDATE_FAILURE_STOP_AND_RETRY" }
          ]
        }
      }
    },
    "drawRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elementId",
        "family",
        "configured",
        "attempted",
        "submitted",
        "committed",
        "suppressed",
        "failed",
        "hasSubmittedPosition",
        "positionMin",
        "positionMax"
      ],
      "properties": {
        "elementId": { "type": "string", "minLength": 1 },
        "family": { "enum": ["MESH", "SPRITE", "DECAL", "RIBBON"] },
        "configured": { "type": "integer", "minimum": 0 },
        "attempted": { "type": "integer", "minimum": 0 },
        "submitted": { "type": "integer", "minimum": 0 },
        "committed": { "type": "integer", "minimum": 0 },
        "suppressed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "hasSubmittedPosition": { "type": "boolean" },
        "positionMin": { "$ref": "#/$defs/vec3" },
        "positionMax": { "$ref": "#/$defs/vec3" }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "requestedSeconds",
        "evaluatedSeconds",
        "rootPosition",
        "hasSubmittedBounds",
        "submittedPositionMin",
        "submittedPositionMax",
        "transactionCommitted",
        "rows"
      ],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "requestedSeconds": { "type": "number", "minimum": 0 },
        "evaluatedSeconds": { "type": "number", "minimum": 0 },
        "rootPosition": { "$ref": "#/$defs/vec3" },
        "hasSubmittedBounds": { "type": "boolean" },
        "submittedPositionMin": { "$ref": "#/$defs/vec3" },
        "submittedPositionMax": { "$ref": "#/$defs/vec3" },
        "transactionCommitted": { "const": true },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/drawRow" }
        }
      }
    },
    "elementTotal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elementId",
        "family",
        "preparedSamples",
        "attemptedSamples",
        "submittedDraws",
        "committedDraws",
        "suppressedDraws",
        "failedDraws"
      ],
      "properties": {
        "elementId": { "type": "string", "minLength": 1 },
        "family": { "enum": ["MESH", "SPRITE", "DECAL", "RIBBON"] },
        "preparedSamples": { "type": "integer", "minimum": 0 },
        "attemptedSamples": { "type": "integer", "minimum": 0 },
        "submittedDraws": { "type": "integer", "minimum": 0 },
        "committedDraws": { "type": "integer", "minimum": 0 },
        "suppressedDraws": { "type": "integer", "minimum": 0 },
        "failedDraws": { "type": "integer", "minimum": 0 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "combatObjectArchetypeId",
        "clientVisualId",
        "effectAssetId",
        "documentPath",
        "documentRawSha256",
        "documentTypedCodecSha256",
        "rootPolicy",
        "effectDurationSeconds",
        "rootWorldDistinctCount",
        "submittedBoundsDistinctCount",
        "unauditedSubmittedDraws",
        "auditedElementIds",
        "samples",
        "elementTotals"
      ],
      "properties": {
        "combatObjectArchetypeId": { "type": "string", "minLength": 1 },
        "clientVisualId": { "type": "string", "minLength": 1 },
        "effectAssetId": { "type": "string", "minLength": 1 },
        "documentPath": { "type": "string", "minLength": 1 },
        "documentRawSha256": { "$ref": "#/$defs/sha256" },
        "documentTypedCodecSha256": { "$ref": "#/$defs/sha256" },
        "rootPolicy": { "enum": ["FIXED_WORLD_ROOT", "MOVING_WORLD_ROOT"] },
        "effectDurationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "rootWorldDistinctCount": { "type": "integer", "minimum": 1 },
        "submittedBoundsDistinctCount": { "type": "integer", "minimum": 1 },
        "unauditedSubmittedDraws": { "type": "integer", "minimum": 0 },
        "auditedElementIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "samples": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/sample" }
        },
        "elementTotals": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/elementTotal" }
        }
      }
    }
  }
}
