{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lostark.local/schemas/effect-visual-program-corpus-v1.json",
  "title": "LostArk generic Effect visual-program corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "formatVersion",
    "corpusId",
    "contractRole",
    "selectorContract",
    "adapterContracts",
    "inputArtifacts",
    "extensionCanaries",
    "presentationSchedules",
    "visualRows",
    "supplementalElements",
    "bakedEdgeHistories",
    "denominators",
    "transactionPolicy",
    "artifactSha256"
  ],
  "properties": {
    "schema": {
      "const": "lostark.effect-visual-program-corpus"
    },
    "formatVersion": {
      "const": 1
    },
    "corpusId": {
      "$ref": "#/$defs/stableId"
    },
    "contractRole": {
      "const": "PHASE2_EXECUTION_PROJECTION_INPUT_NOT_RUNTIME_CATALOG"
    },
    "selectorContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exactFields", "prohibitedFields"],
      "properties": {
        "exactFields": {
          "const": ["effectAssetId", "occurrenceId"]
        },
        "prohibitedFields": {
          "const": ["characterClass", "skillId", "sourceOrder"]
        }
      }
    },
    "adapterContracts": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/adapterContract"
      }
    },
    "inputArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/inputArtifact"
      }
    },
    "extensionCanaries": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/extensionCanary"
      }
    },
    "presentationSchedules": {
      "type": "array",
      "minItems": 35,
      "maxItems": 35,
      "items": {
        "$ref": "#/$defs/presentationSchedule"
      }
    },
    "visualRows": {
      "type": "array",
      "minItems": 135,
      "maxItems": 135,
      "items": {
        "$ref": "#/$defs/visualRow"
      }
    },
    "supplementalElements": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/supplementalElement" }
    },
    "bakedEdgeHistories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/bakedEdgeHistory" }
    },
    "denominators": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stageCount",
        "presentationScheduleCount",
        "visualRowCount",
        "combatBaVisualRowCount",
        "artistFLocalDecalVisualRowCount",
        "cascadeRibbonVisualRowCount",
        "supplementalElementCount",
        "artistFCascadeRibbonElementCount",
        "animationTrailElementCount",
        "bakedEdgeLightElementCount",
        "admittedBoundedCount",
        "failClosedCount",
        "legacyApproximationCount",
        "boundedReconstructionCount",
        "productMutationCount"
      ],
      "properties": {
        "stageCount": { "const": 12 },
        "presentationScheduleCount": { "const": 35 },
        "visualRowCount": { "const": 135 },
        "combatBaVisualRowCount": { "const": 133 },
        "artistFLocalDecalVisualRowCount": { "const": 2 },
        "cascadeRibbonVisualRowCount": { "const": 4 },
        "supplementalElementCount": { "const": 9 },
        "artistFCascadeRibbonElementCount": { "const": 1 },
        "animationTrailElementCount": { "const": 7 },
        "bakedEdgeLightElementCount": { "const": 1 },
        "admittedBoundedCount": { "const": 68 },
        "failClosedCount": { "const": 67 },
        "legacyApproximationCount": { "const": 66 },
        "boundedReconstructionCount": { "const": 2 },
        "productMutationCount": { "const": 0 }
      }
    },
    "transactionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loadOrder",
        "commitMode",
        "failureAction",
        "productMutation",
        "runtimeCatalogMutation"
      ],
      "properties": {
        "loadOrder": {
          "const": ["parse", "validate", "stage", "commit"]
        },
        "commitMode": {
          "const": "ATOMIC_REPLACE_AFTER_FULL_CORPUS_VALIDATION"
        },
        "failureAction": {
          "const": "PRESERVE_PREVIOUS_ARTIFACT_AND_PRODUCT_RUNTIME"
        },
        "productMutation": { "const": false },
        "runtimeCatalogMutation": { "const": false }
      }
    },
    "artifactSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableSha256": {
      "oneOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "family": {
      "enum": [
        "MESH_PARTICLE",
        "SPRITE_PARTICLE",
        "DECAL_PARTICLE",
        "CASCADE_RIBBON",
        "ANIMATION_TRAIL",
        "LIGHT_PARTICLE",
        "SCREEN_POST"
      ]
    },
    "adapterContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapterId",
        "family",
        "packetLayouts",
        "allowedResourceRoles"
      ],
      "properties": {
        "adapterId": {
          "$ref": "#/$defs/stableId"
        },
        "family": {
          "$ref": "#/$defs/family"
        },
        "packetLayouts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "allowedResourceRoles": {
          "type": "array",
          "items": {
            "enum": [
              "BASE_COLOR",
              "DIFFUSE",
              "DISSOLVE",
              "EMISSIVE",
              "HEIGHT",
              "MASK",
              "MESH_MODEL",
              "NOISE",
              "NORMAL",
              "SPECULAR"
            ]
          }
        }
      }
    },
    "inputArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "rawSha256", "roles"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "rawSha256": {
          "$ref": "#/$defs/sha256"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        }
      }
    },
    "extensionCanary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canaryId",
        "domain",
        "selector",
        "selectorSha256",
        "sourceArtifact",
        "family",
        "adapterId",
        "packetLayout",
        "fidelity",
        "disposition",
        "productCountContribution",
        "admissionBlockers",
        "canarySha256"
      ],
      "properties": {
        "canaryId": { "$ref": "#/$defs/stableId" },
        "domain": { "enum": ["WARLORD", "VALTAN"] },
        "selector": { "$ref": "#/$defs/selector" },
        "selectorSha256": { "$ref": "#/$defs/sha256" },
        "sourceArtifact": { "$ref": "#/$defs/inputArtifact" },
        "family": { "$ref": "#/$defs/family" },
        "adapterId": { "$ref": "#/$defs/stableId" },
        "packetLayout": { "$ref": "#/$defs/stableId" },
        "fidelity": { "const": "EVIDENCE_ONLY" },
        "disposition": { "const": "FAIL_CLOSED" },
        "productCountContribution": { "const": false },
        "admissionBlockers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "canarySha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "presentationSchedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "presentationOccurrenceId",
        "stageId",
        "effectAssetId",
        "sourceEventId",
        "stageLocalTimeSeconds",
        "sourceRowIds",
        "scheduleSha256"
      ],
      "properties": {
        "presentationOccurrenceId": {
          "$ref": "#/$defs/stableId"
        },
        "stageId": {
          "$ref": "#/$defs/stableId"
        },
        "effectAssetId": {
          "$ref": "#/$defs/stableId"
        },
        "sourceEventId": {
          "oneOf": [
            { "$ref": "#/$defs/stableId" },
            { "type": "null" }
          ]
        },
        "stageLocalTimeSeconds": {
          "type": "number",
          "minimum": 0
        },
        "sourceRowIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "scheduleSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effectAssetId", "occurrenceId"],
      "properties": {
        "effectAssetId": {
          "$ref": "#/$defs/stableId"
        },
        "occurrenceId": {
          "$ref": "#/$defs/stableId"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "characterClass",
        "skillId",
        "stageIndex",
        "sourceOrder",
        "sourceElementId",
        "sourceRowId"
      ],
      "properties": {
        "scope": {
          "enum": ["COMBAT_BA", "ARTIST_F_LOCAL_DECAL"]
        },
        "characterClass": {
          "type": "string",
          "minLength": 1
        },
        "skillId": {
          "type": "integer",
          "minimum": 1
        },
        "stageIndex": {
          "type": "integer",
          "minimum": 0
        },
        "sourceOrder": {
          "type": "integer",
          "minimum": 0
        },
        "sourceElementId": {
          "type": "string",
          "minLength": 1
        },
        "sourceRowId": {
          "$ref": "#/$defs/stableId"
        }
      }
    },
    "rowSchedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stageId",
        "presentationOccurrenceId",
        "joinKind",
        "sourceEventId",
        "sourceTimelineSeconds",
        "externalScheduleGroupId"
      ],
      "properties": {
        "stageId": {
          "oneOf": [
            { "$ref": "#/$defs/stableId" },
            { "type": "null" }
          ]
        },
        "presentationOccurrenceId": {
          "oneOf": [
            { "$ref": "#/$defs/stableId" },
            { "type": "null" }
          ]
        },
        "joinKind": {
          "type": "string",
          "minLength": 1
        },
        "sourceEventId": {
          "oneOf": [
            { "$ref": "#/$defs/stableId" },
            { "type": "null" }
          ]
        },
        "sourceTimelineSeconds": {
          "type": "number",
          "minimum": 0
        },
        "externalScheduleGroupId": {
          "oneOf": [
            { "$ref": "#/$defs/stableId" },
            { "type": "null" }
          ]
        }
      }
    },
    "payloadRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "rawSha256", "recordId", "recordSha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "rawSha256": {
          "$ref": "#/$defs/sha256"
        },
        "recordId": {
          "type": "string",
          "minLength": 1
        },
        "recordSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sourceRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "rendererShape",
        "resolvedRendererShape",
        "sourceRowSha256",
        "sourceRecipeEvidenceSha256",
        "recipeSha256",
        "moduleClosureSha256",
        "moduleCount",
        "typedFamilyResolution"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "rendererShape": { "type": "string" },
        "resolvedRendererShape": { "type": "string", "minLength": 1 },
        "sourceRowSha256": { "$ref": "#/$defs/sha256" },
        "sourceRecipeEvidenceSha256": { "$ref": "#/$defs/sha256" },
        "recipeSha256": { "$ref": "#/$defs/sha256" },
        "moduleClosureSha256": { "$ref": "#/$defs/sha256" },
        "moduleCount": { "type": "integer", "minimum": 0 },
        "typedFamilyResolution": { "$ref": "#/$defs/typedFamilyResolution" }
      }
    },
    "typedFamilyResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolutionKind", "declaredRendererFamily", "declaredRendererShape",
        "resolvedFamily", "resolvedRendererShape", "typeDataStableId",
        "typeDataClassName", "typeDataObjectPath", "typeDataModuleSha256",
        "resolutionSha256"
      ],
      "properties": {
        "resolutionKind": {
          "enum": [
            "TYPE_DATA_MODULE_V1",
            "DECLARED_RENDERER_FAMILY_FALLBACK_V1"
          ]
        },
        "declaredRendererFamily": { "type": "string", "minLength": 1 },
        "declaredRendererShape": { "type": "string" },
        "resolvedFamily": { "$ref": "#/$defs/family" },
        "resolvedRendererShape": { "type": "string", "minLength": 1 },
        "typeDataStableId": { "type": "string" },
        "typeDataClassName": { "type": "string" },
        "typeDataObjectPath": { "type": "string" },
        "typeDataModuleSha256": { "$ref": "#/$defs/nullableSha256" },
        "resolutionSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sourceImportBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basisId", "status", "attachmentSha256"],
      "properties": {
        "basisId": { "$ref": "#/$defs/stableId" },
        "status": {
          "enum": [
            "UNRESOLVED_FAIL_CLOSED",
            "SOURCE_TYPED_BOUNDED"
          ]
        },
        "attachmentSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "resourceRole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "slotId",
        "assetId",
        "resolutionStatus",
        "rawSha256",
        "byteCount",
        "shaderRegister",
        "sourceChannel"
      ],
      "properties": {
        "role": {
          "enum": [
            "BASE_COLOR",
            "DIFFUSE",
            "DISSOLVE",
            "EMISSIVE",
            "HEIGHT",
            "MASK",
            "MESH_MODEL",
            "NOISE",
            "NORMAL",
            "SPECULAR"
          ]
        },
        "slotId": {
          "type": "string",
          "minLength": 1
        },
        "assetId": {
          "type": "string",
          "minLength": 1
        },
        "resolutionStatus": {
          "enum": [
            "TARGET_DOCUMENT_REFERENCE",
            "SOURCE_EVIDENCE_ONLY",
            "EXACT_RUNTIME_PAYLOAD_SHA256"
          ]
        },
        "rawSha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "byteCount": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "shaderRegister": {
          "oneOf": [
            { "type": "string", "pattern": "^t[0-9]+$" },
            { "type": "null" }
          ]
        },
        "sourceChannel": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        }
      }
    },
    "executionBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "basisSha256"],
      "properties": {
        "status": {
          "enum": [
            "TARGET_DOCUMENT_BOUNDED",
            "SOURCE_TYPED_BOUNDED",
            "UNRESOLVED_FAIL_CLOSED"
          ]
        },
        "basisSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "executionProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "adapterId",
        "packetLayout",
        "tuningEligibleTransform",
        "fidelity",
        "disposition",
        "nativeExecution",
        "sourceExact",
        "executionBasis",
        "resourceRoles",
        "admissionBlockers",
        "preservedLimitations",
        "productMutation"
      ],
      "properties": {
        "family": { "$ref": "#/$defs/family" },
        "adapterId": { "$ref": "#/$defs/stableId" },
        "packetLayout": { "$ref": "#/$defs/stableId" },
        "tuningEligibleTransform": { "type": "boolean" },
        "fidelity": {
          "enum": [
            "LEGACY_APPROXIMATION",
            "BOUNDED_RECONSTRUCTION",
            "EVIDENCE_ONLY"
          ]
        },
        "disposition": {
          "enum": ["ADMITTED_BOUNDED", "FAIL_CLOSED"]
        },
        "nativeExecution": { "const": false },
        "sourceExact": { "const": false },
        "executionBasis": { "$ref": "#/$defs/executionBasis" },
        "resourceRoles": {
          "type": "array",
          "items": { "$ref": "#/$defs/resourceRole" }
        },
        "admissionBlockers": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" }
        },
        "preservedLimitations": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" }
        },
        "productMutation": { "const": false }
      }
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "vec4": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number" }
    },
    "transform3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "rotationDegrees", "scale"],
      "properties": {
        "position": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
        "rotationDegrees": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
        "scale": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } }
      }
    },
    "trailTiming": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startDelaySeconds", "lifeTimeSeconds", "afterImageSeconds", "dissolveStartNormalized"],
      "properties": {
        "startDelaySeconds": { "type": "number", "minimum": 0 },
        "lifeTimeSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "afterImageSeconds": { "type": "number", "minimum": 0 },
        "dissolveStartNormalized": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "trailAttachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "follow", "sourceAnchorSlotId", "runtimeAnchorSlotId", "runtimeBoneName", "socketLocalTransform"],
      "properties": {
        "enabled": { "type": "boolean" },
        "follow": { "type": "boolean" },
        "sourceAnchorSlotId": { "type": "string" },
        "runtimeAnchorSlotId": { "type": "string" },
        "runtimeBoneName": { "type": "string" },
        "socketLocalTransform": { "$ref": "#/$defs/transform3" }
      }
    },
    "trailGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxPoints", "pointLifeTimeSeconds", "sampleIntervalSeconds", "minimumDistance", "startWidth", "endWidth", "faceCamera"],
      "properties": {
        "maxPoints": { "type": "integer", "minimum": 2 },
        "pointLifeTimeSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleIntervalSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "minimumDistance": { "type": "number", "minimum": 0 },
        "startWidth": { "type": "number", "exclusiveMinimum": 0 },
        "endWidth": { "type": "number", "minimum": 0 },
        "faceCamera": { "type": "boolean" }
      }
    },
    "animationTrailPacketV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packetVersion", "adapterId", "boundedSemanticReplay", "nativeExecution",
        "runtimeCarrier", "sourceNotifyType", "sourceEventId",
        "sourceEventRecordSha256", "sourceAsset", "clip", "localTimeSeconds",
        "globalTimeSeconds", "durationSeconds", "targetElementId", "targetTiming",
        "attachment", "trail", "preservedLimitations", "packetSha256"
      ],
      "properties": {
        "packetVersion": { "const": 1 },
        "adapterId": { "const": "animation-trail-document-v12" },
        "boundedSemanticReplay": { "const": true },
        "nativeExecution": { "const": false },
        "runtimeCarrier": { "const": "EFFECT_TYPED_ANIMATION_TRAIL_V1" },
        "sourceNotifyType": { "const": "Trails" },
        "sourceEventId": { "$ref": "#/$defs/stableId" },
        "sourceEventRecordSha256": { "$ref": "#/$defs/sha256" },
        "sourceAsset": { "type": "string", "minLength": 1 },
        "clip": { "$ref": "#/$defs/stableId" },
        "localTimeSeconds": { "type": "number", "minimum": 0 },
        "globalTimeSeconds": { "type": "number", "minimum": 0 },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "targetElementId": { "$ref": "#/$defs/stableId" },
        "targetTiming": { "$ref": "#/$defs/trailTiming" },
        "attachment": { "$ref": "#/$defs/trailAttachment" },
        "trail": { "$ref": "#/$defs/trailGeometry" },
        "preservedLimitations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stableId" } },
        "packetSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "animationTrailPacketV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packetVersion", "adapterId", "boundedSemanticReplay", "nativeExecution",
        "runtimeCarrier", "sourceNotifyType", "sourceEventId",
        "sourceEventRecordSha256", "sourceAsset", "clip", "localTimeSeconds",
        "globalTimeSeconds", "durationSeconds", "targetElementId", "targetTiming",
        "attachment", "trail", "historyId", "historySha256",
        "playbackClampSeconds", "coordinateBasis", "preservedLimitations",
        "packetSha256"
      ],
      "properties": {
        "packetVersion": { "const": 2 },
        "adapterId": { "const": "animation-trail-document-v12" },
        "boundedSemanticReplay": { "const": true },
        "nativeExecution": { "const": false },
        "runtimeCarrier": { "const": "EFFECT_TYPED_ANIMATION_TRAIL_BAKED_EDGE_V1" },
        "sourceNotifyType": { "const": "Trails" },
        "sourceEventId": { "type": "string", "minLength": 1 },
        "sourceEventRecordSha256": { "$ref": "#/$defs/sha256" },
        "sourceAsset": { "type": "string", "minLength": 1 },
        "clip": { "$ref": "#/$defs/stableId" },
        "localTimeSeconds": { "type": "number", "minimum": 0 },
        "globalTimeSeconds": { "type": "number", "minimum": 0 },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "targetElementId": { "$ref": "#/$defs/stableId" },
        "targetTiming": { "$ref": "#/$defs/trailTiming" },
        "attachment": { "$ref": "#/$defs/trailAttachment" },
        "trail": { "$ref": "#/$defs/trailGeometry" },
        "historyId": { "$ref": "#/$defs/stableId" },
        "historySha256": { "$ref": "#/$defs/sha256" },
        "playbackClampSeconds": { "type": "number", "exclusiveMinimum": 0 },
