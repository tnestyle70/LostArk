{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lostark.local/schemas/lostark.valtan-project-authored-priority-patch-plan.schema.json",
  "title": "Valtan project-authored priority missing-only patch plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "formatVersion",
    "ownerArchetypeId",
    "generator",
    "policy",
    "resourceVerification",
    "resourceRoleDispositions",
    "targets",
    "highJumpAirbornePatch",
    "projectilePresentations"
  ],
  "properties": {
    "schema": {
      "const": "lostark.valtan-project-authored-priority-patch-plan"
    },
    "formatVersion": {
      "const": 1
    },
    "ownerArchetypeId": {
      "const": "BOSS_VALTAN"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script", "policyVersion"],
      "properties": {
        "script": {
          "const": "Tools/EffectPipeline/build_valtan_project_authored_priority_candidates.py"
        },
        "policyVersion": {
          "const": 1
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reconcileMode",
        "sourceClaimPolicy",
        "portalRushExcluded",
        "newStandaloneLightAllowed",
        "genericDustDebrisAllowed",
        "sourceRecipeEnabled",
        "sourcePresentationEnabled",
        "canonicalMutationPerformed"
      ],
      "properties": {
        "reconcileMode": {
          "const": "MISSING_ONLY"
        },
        "sourceClaimPolicy": {
          "const": "NO_SOURCE_EXACT_CLAIMS"
        },
        "portalRushExcluded": {
          "const": true
        },
        "newStandaloneLightAllowed": {
          "const": false
        },
        "genericDustDebrisAllowed": {
          "const": false
        },
        "sourceRecipeEnabled": {
          "const": false
        },
        "sourcePresentationEnabled": {
          "const": false
        },
        "canonicalMutationPerformed": {
          "const": false
        }
      }
    },
    "resourceVerification": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/resourceVerification"
      }
    },
    "resourceRoleDispositions": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/resourceRoleDisposition"
      }
    },
    "targets": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "highJumpAirbornePatch": {
      "$ref": "#/$defs/highJumpAirbornePatch"
    },
    "projectilePresentations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/projectilePresentation"
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "resourceAssetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?:Effect/Valtan/(?:[^./\\\\]+/)*[^./\\\\]+\\.(?:dds|wmodel)|Character/Valtan/(?:[^./\\\\]+/)*[^./\\\\]+\\.wmodel)$"
    },
    "resourceVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "byteSize", "sha256"],
      "properties": {
        "assetId": {
          "$ref": "#/$defs/resourceAssetId"
        },
        "byteSize": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "resourceRoleDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "requestedRole",
        "evidenceStatus",
        "sourceEvidenceContext",
        "candidateDisposition",
        "candidateEffectAssetIds",
        "handTunableFields"
      ],
      "properties": {
        "assetId": {
          "$ref": "#/$defs/resourceAssetId"
        },
        "requestedRole": {
          "enum": [
            "DASH_FORWARD_RED_PATH",
            "MAGIC_DONUT_RING_BOUNDARIES",
            "MAGIC_DONUT_ANNULUS_UV_SWEEP",
            "FLOOR_WIPE_IMPACT_DIFFUSE",
            "FLOOR_WIPE_GUIDE_AND_IMPACT_MASK",
            "FLOOR_WIPE_IMPACT_NOISE",
            "FRONT_BACK_FRONT_FINAL_GROUND_IMPACT",
            "HIGH_JUMP_AXE_GROUND_IMPACT"
          ]
        },
        "evidenceStatus": {
          "enum": [
            "EXACT_OTHER_PATTERN",
            "EXACT_SAME_PATTERN_LIMITED_STAGE",
            "EXACT_SAME_PATTERN_SOURCE_ONLY_OCCURRENCE",
            "NO_TARGET_SOURCE_JOIN",
            "PROJECT_PALETTE_REUSE_NO_SOURCE_CLAIM"
          ]
        },
        "sourceEvidenceContext": {
          "type": "string",
          "minLength": 1
        },
        "candidateDisposition": {
          "const": "PROJECT_TUNED_CANDIDATE"
        },
        "candidateEffectAssetIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "handTunableFields": {
          "const": [
            "detail.color.multiply",
            "detail.linearLerp.endScale",
            "detail.transform.scale",
            "detail.uv.speed"
          ]
        }
      }
    },
    "desiredElement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elementId",
        "sourceNode",
        "disposition",
        "reconcileAction",
        "canonicalElementSha256"
      ],
      "properties": {
        "elementId": {
          "$ref": "#/$defs/stableId"
        },
        "sourceNode": {
          "allOf": [
            {
              "$ref": "#/$defs/stableId"
            },
            {
              "pattern": "^project-authored:"
            }
          ]
        },
        "disposition": {
          "enum": ["PROJECT_AUTHORED", "PROJECT_TUNED_OVERRIDE"]
        },
        "reconcileAction": {
          "enum": ["APPEND_MISSING", "PRESERVE_EXISTING"]
        },
        "canonicalElementSha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patternId",
        "stageId",
        "actionId",
        "clipOccurrenceId",
        "targetEffectAssetId",
        "targetAuthoringPath",
        "canonicalState",
        "disposition",
        "presentationOnly",
        "overlayDocumentPath",
        "overlayDocumentSha256",
        "desiredElements",
        "preservedCanonicalElementIds",
        "excludedSourceOccurrenceIds",
        "notes"
      ],
      "properties": {
        "patternId": {
          "enum": [
            "VALTAN_DASH_CHARGE",
            "VALTAN_MAGIC_CHOICE",
            "VALTAN_FLOOR_WIPE_130",
            "VALTAN_HIGH_JUMP",
            "VALTAN_FRONT_BACK_FRONT"
          ]
        },
        "stageId": {
          "type": "string",
          "minLength": 1
        },
        "actionId": {
          "$ref": "#/$defs/stableId"
        },
        "clipOccurrenceId": {
          "$ref": "#/$defs/stableId"
        },
        "targetEffectAssetId": {
          "$ref": "#/$defs/stableId"
        },
        "targetAuthoringPath": {
          "type": "string",
          "pattern": "^Data/Effects/Authored/effect\\.valtan\\.[a-z0-9.-]+\\.effect\\.json$"
        },
        "canonicalState": {
          "enum": ["EXISTING_DOCUMENT", "MISSING_DOCUMENT"]
        },
        "disposition": {
          "enum": ["PROJECT_AUTHORED", "PROJECT_TUNED_OVERRIDE"]
        },
        "presentationOnly": {
          "type": "boolean"
        },
        "overlayDocumentPath": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^Data/Effects/Imported/Valtan/ProjectAuthoredPriority/effect\\.valtan\\.[a-z0-9.-]+\\.project-authored-overlay\\.effect\\.json$"
            },
            {
              "type": "null"
            }
          ]
        },
        "overlayDocumentSha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "desiredElements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/desiredElement"
          }
        },
        "preservedCanonicalElementIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "excludedSourceOccurrenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "identityTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "rotationDegrees", "scale"],
      "properties": {
        "position": {
          "const": [0, 0, 0]
        },
        "rotationDegrees": {
          "const": [0, 0, 0]
        },
        "scale": {
          "const": [1, 1, 1]
        }
      }
    },
    "catalogRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effectAssetId", "payloadKind", "authoringPath"],
      "properties": {
        "effectAssetId": {
          "const": "effect.valtan.high-jump.airborne"
        },
        "payloadKind": {
          "const": "DIRECT_AUTHORED_DOCUMENT_V13"
        },
        "authoringPath": {
          "const": "Effects/Authored/effect.valtan.high-jump.airborne.effect.json"
        }
      }
    },
    "cueRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindingId",
        "occurrenceId",
        "patternId",
        "stageId",
        "actionId",
        "clipOccurrenceId",
        "effectAssetId",
        "anchorSlotId",
        "followPolicy",
        "stopPolicy",
        "repeatPolicy",
        "sourceStartMs",
        "sourceEndMs",
        "localTransform"
      ],
      "properties": {
        "bindingId": {
          "const": "cue.valtan.high-jump.airborne.project-authored"
        },
        "occurrenceId": {
          "const": "cue.valtan.high-jump.airborne.project-authored.occurrence.01"
        },
        "patternId": {
          "const": "VALTAN_HIGH_JUMP"
        },
        "stageId": {
          "const": "AIRBORNE"
        },
        "actionId": {
          "const": "valtan.attack.high-jump.airborne"
        },
        "clipOccurrenceId": {
          "const": "valtan.attack.high-jump.airborne.clip.01"
        },
        "effectAssetId": {
          "const": "effect.valtan.high-jump.airborne"
        },
        "anchorSlotId": {
          "const": "root"
        },
        "followPolicy": {
          "const": "snapshot"
        },
        "stopPolicy": {
          "const": "natural"
        },
        "repeatPolicy": {
          "const": "once"
        },
        "sourceStartMs": {
          "const": 0
        },
        "sourceEndMs": {
          "type": "null"
        },
        "localTransform": {
          "$ref": "#/$defs/identityTransform"
        }
      }
    },
    "highJumpAirbornePatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogRow", "cueRow", "authoringDocument", "authority"],
      "properties": {
        "catalogRow": {
          "$ref": "#/$defs/catalogRow"
        },
        "cueRow": {
          "$ref": "#/$defs/cueRow"
        },
        "authoringDocument": {
          "type": "object",
          "additionalProperties": false,
          "required": ["effectAssetId", "targetAuthoringPath"],
          "properties": {
            "effectAssetId": {
              "const": "effect.valtan.high-jump.airborne"
            },
            "targetAuthoringPath": {
              "const": "Data/Effects/Authored/effect.valtan.high-jump.airborne.effect.json"
            }
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "presentationOnly",
            "serverGameplayChange",
            "serverDamagePolicy",
            "projectileAuthorityStatus"
          ],
          "properties": {
            "presentationOnly": {
              "const": true
            },
            "serverGameplayChange": {
              "const": false
            },
            "serverDamagePolicy": {
              "const": "UNCHANGED_EXISTING_LAND_STAGE_AUTHORITY"
            },
            "projectileAuthorityStatus": {
              "const": "PRESENTATION_ONLY_OFFICIAL_ASSET_REUSE"
            }
          }
        }
      }
    },
    "projectilePresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "presentationId",
        "patternId",
        "stageId",
        "elementId",
        "disposition",
        "modelAssetId",
        "bossCatalogEvidence",
        "geometryProvenance",
        "baseTextureProvenance",
        "trajectoryTimingProvenance",
        "sourceActionPayloadClaim",
        "presentationOnly",
        "serverGameplayChange"
      ],
      "properties": {
        "presentationId": {
          "allOf": [
            {
              "$ref": "#/$defs/stableId"
            },
            {
              "pattern": "^project-authored:valtan\\.high-jump\\.airborne\\.beat-[0-9]{2}\\.axe$"
            }
          ]
        },
        "patternId": {
          "const": "VALTAN_HIGH_JUMP"
        },
        "stageId": {
          "const": "AIRBORNE"
        },
        "elementId": {
          "type": "string",
          "pattern": "^project-axe-beat-[0-9]{2}-falling-axe$"
        },
        "disposition": {
          "const": "PROJECT_AUTHORED_OFFICIAL_ASSET_REUSE"
        },
        "modelAssetId": {
          "const": "Character/Valtan/ValtanWeapon.wmodel"
        },
        "bossCatalogEvidence": {
          "const": "BOSS_VALTAN.weaponModel"
        },
        "geometryProvenance": {
          "const": "OFFICIAL_GEOMETRY_EXACT"
        },
        "baseTextureProvenance": {
          "const": "OFFICIAL_MODEL_MATERIAL_BASE_TEXTURE_EXACT"
        },
        "trajectoryTimingProvenance": {
          "const": "PROJECT_AUTHORED"
        },
        "sourceActionPayloadClaim": {
          "const": "NONE"
        },
        "presentationOnly": {
          "const": true
        },
        "serverGameplayChange": {
          "const": false
        }
      }
    }
  }
}
