{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lostark.local/schemas/lostark.valtan-project-authored-priority-patch-plan.schema.json",
  "title": "Valtan project-authored priority missing-only patch plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "formatVersion",
    "ownerArchetypeId",
    "generator",
    "policy",
    "resourceVerification",
    "resourceRoleDispositions",
    "targets",
    "highJumpCombatObjectTransfer",
    "officialAxePresentation"
  ],
  "properties": {
    "schema": {
      "const": "lostark.valtan-project-authored-priority-patch-plan"
    },
    "formatVersion": {
      "const": 1
    },
    "ownerArchetypeId": {
      "const": "BOSS_VALTAN"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script",
        "policyVersion"
      ],
      "properties": {
        "script": {
          "const": "Tools/EffectPipeline/build_valtan_project_authored_priority_candidates.py"
        },
        "policyVersion": {
          "const": 1
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reconcileMode",
        "sourceClaimPolicy",
        "portalRushExcluded",
        "newStandaloneLightAllowed",
        "genericDustDebrisAllowed",
        "sourceRecipeEnabled",
        "sourcePresentationEnabled",
        "canonicalMutationPerformed"
      ],
      "properties": {
        "reconcileMode": {
          "const": "MISSING_ONLY"
        },
        "sourceClaimPolicy": {
          "const": "NO_SOURCE_EXACT_CLAIMS"
        },
        "portalRushExcluded": {
          "const": true
        },
        "newStandaloneLightAllowed": {
          "const": false
        },
        "genericDustDebrisAllowed": {
          "const": false
        },
        "sourceRecipeEnabled": {
          "const": false
        },
        "sourcePresentationEnabled": {
          "const": false
        },
        "canonicalMutationPerformed": {
          "const": false
        }
      }
    },
    "resourceVerification": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/resourceVerification"
      }
    },
    "resourceRoleDispositions": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/resourceRoleDisposition"
      }
    },
    "targets": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "highJumpCombatObjectTransfer": {
      "$ref": "#/$defs/highJumpCombatObjectTransfer"
    },
    "officialAxePresentation": {
      "$ref": "#/$defs/officialAxePresentation"
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "resourceAssetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?:Effect/Valtan/(?:[^./\\\\]+/)*[^./\\\\]+\\.(?:dds|wmodel)|Character/Valtan/(?:[^./\\\\]+/)*[^./\\\\]+\\.wmodel)$"
    },
    "resourceVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "byteSize",
        "sha256"
      ],
      "properties": {
        "assetId": {
          "$ref": "#/$defs/resourceAssetId"
        },
        "byteSize": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "resourceRoleDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "requestedRole",
        "evidenceStatus",
        "sourceEvidenceContext",
        "candidateDisposition",
        "candidateEffectAssetIds",
        "handTunableFields"
      ],
      "properties": {
        "assetId": {
          "$ref": "#/$defs/resourceAssetId"
        },
        "requestedRole": {
          "enum": [
            "DASH_FORWARD_RED_PATH",
            "MAGIC_DONUT_RING_BOUNDARIES",
            "MAGIC_DONUT_ANNULUS_UV_SWEEP",
            "FLOOR_WIPE_IMPACT_DIFFUSE",
            "FLOOR_WIPE_GUIDE_AND_IMPACT_MASK",
            "FLOOR_WIPE_IMPACT_NOISE",
            "FRONT_BACK_FRONT_FINAL_GROUND_IMPACT",
            "HIGH_JUMP_AXE_GROUND_IMPACT"
          ]
        },
        "evidenceStatus": {
          "enum": [
            "EXACT_OTHER_PATTERN",
            "EXACT_SAME_PATTERN_LIMITED_STAGE",
            "EXACT_SAME_PATTERN_SOURCE_ONLY_OCCURRENCE",
            "NO_TARGET_SOURCE_JOIN",
            "PROJECT_PALETTE_REUSE_NO_SOURCE_CLAIM"
          ]
        },
        "sourceEvidenceContext": {
          "type": "string",
          "minLength": 1
        },
        "candidateDisposition": {
          "const": "PROJECT_TUNED_CANDIDATE"
        },
        "candidateEffectAssetIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "handTunableFields": {
          "const": [
            "detail.color.multiply",
            "detail.linearLerp.endScale",
            "detail.transform.scale",
            "detail.uv.speed"
          ]
        }
      }
    },
    "desiredElement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elementId",
        "sourceNode",
        "disposition",
        "reconcileAction",
        "canonicalElementSha256"
      ],
      "properties": {
        "elementId": {
          "$ref": "#/$defs/stableId"
        },
        "sourceNode": {
          "oneOf": [
            {
              "const": ""
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/stableId"
                },
                {
                  "pattern": "^project-authored:"
                }
              ]
            }
          ]
        },
        "disposition": {
          "enum": [
            "PROJECT_AUTHORED",
            "PROJECT_TUNED_OVERRIDE"
          ]
        },
        "reconcileAction": {
          "enum": [
            "APPEND_MISSING",
            "PRESERVE_EXISTING"
          ]
        },
        "canonicalElementSha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patternId",
        "stageId",
        "actionId",
        "clipOccurrenceId",
        "targetEffectAssetId",
        "targetAuthoringPath",
        "canonicalState",
        "disposition",
        "presentationOnly",
        "overlayDocumentPath",
        "overlayDocumentSha256",
        "desiredElements",
        "preservedCanonicalElementIds",
        "excludedSourceOccurrenceIds",
        "notes"
      ],
      "properties": {
        "patternId": {
          "enum": [
            "VALTAN_DASH_CHARGE",
            "VALTAN_MAGIC_CHOICE",
            "VALTAN_FLOOR_WIPE_130",
            "VALTAN_HIGH_JUMP",
            "VALTAN_FRONT_BACK_FRONT"
          ]
        },
        "stageId": {
          "type": "string",
          "minLength": 1
        },
        "actionId": {
          "$ref": "#/$defs/stableId"
        },
        "clipOccurrenceId": {
          "$ref": "#/$defs/stableId"
        },
        "targetEffectAssetId": {
          "$ref": "#/$defs/stableId"
        },
        "targetAuthoringPath": {
          "type": "string",
          "pattern": "^Data/Effects/Authored/effect\\.valtan\\.[a-z0-9.-]+\\.effect\\.json$"
        },
        "canonicalState": {
          "const": "EXISTING_DOCUMENT"
        },
        "disposition": {
          "enum": [
            "PROJECT_AUTHORED",
            "PROJECT_TUNED_OVERRIDE"
          ]
        },
        "presentationOnly": {
          "type": "boolean"
        },
        "overlayDocumentPath": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^Data/Effects/Imported/Valtan/ProjectAuthoredPriority/effect\\.valtan\\.[a-z0-9.-]+\\.project-authored-overlay\\.effect\\.json$"
            },
            {
              "type": "null"
            }
          ]
        },
        "overlayDocumentSha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "desiredElements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/desiredElement"
          }
        },
        "preservedCanonicalElementIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "excludedSourceOccurrenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "highJumpCombatObjectTransfer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patternId",
        "stageId",
        "ownerStageActionId",
        "combatObjectArchetypeId",
        "clientVisualId",
        "effectAssetId",
        "targetAuthoringPath",
        "effectCatalogRow",
        "bossCatalogVisualRow",
        "combatObjectContract",
        "retiredBossRoot",
        "authority"
      ],
      "properties": {
        "patternId": {
          "const": "VALTAN_HIGH_JUMP"
        },
        "stageId": {
          "const": "AIRBORNE"
        },
        "ownerStageActionId": {
          "const": "valtan.attack.high-jump.airborne"
        },
        "combatObjectArchetypeId": {
          "const": "combatobject.valtan.high-jump.target-axe"
        },
        "clientVisualId": {
          "const": "combatobject.visual.valtan.high-jump.target-axe.v1"
        },
        "effectAssetId": {
          "const": "effect.valtan.sky-axe.active"
        },
        "targetAuthoringPath": {
          "const": "Data/Effects/Authored/effect.valtan.sky-axe.active.effect.json"
        },
        "effectCatalogRow": {
          "const": {
            "effectAssetId": "effect.valtan.sky-axe.active",
            "payloadKind": "DIRECT_AUTHORED_DOCUMENT_V13",
            "authoringPath": "Effects/Authored/effect.valtan.sky-axe.active.effect.json"
          }
        },
        "bossCatalogVisualRow": {
          "const": {
            "combatObjectArchetypeId": "combatobject.valtan.high-jump.target-axe",
            "clientVisualId": "combatobject.visual.valtan.high-jump.target-axe.v1",
            "effectAssetId": "effect.valtan.sky-axe.active"
          }
        },
        "combatObjectContract": {
          "const": {
            "kind": "FIXED_AREA",
            "originPolicy": "LOCKED_TARGET_PER_ALIVE_PLAYER",
            "lifeMs": 1900,
            "timedImpactMs": 1200,
            "serverDamageProfileId": "damage.valtan.high-jump"
          }
        },
        "retiredBossRoot": {
          "const": {
            "effectAssetId": "effect.valtan.high-jump.airborne",
            "authoringHistoryPath": "Data/Effects/Authored/effect.valtan.high-jump.airborne.effect.json",
            "effectCatalogRegistrationAllowed": false,
            "productCueRegistrationAllowed": false
          }
        },
        "authority": {
          "const": {
            "effectPresentationOnly": true,
            "serverCombatObjectAuthority": true,
            "serverGameplayChange": false,
            "serverDamagePolicy": "TIMED_COMBAT_OBJECT_HIT"
          }
        }
      }
    },
    "officialAxePresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "presentationId",
        "combatObjectArchetypeId",
        "elementId",
        "disposition",
        "modelAssetId",
        "bossCatalogEvidence",
        "geometryProvenance",
        "baseTextureProvenance",
        "trajectoryTimingProvenance",
        "presentationOnly",
        "serverGameplayChange"
      ],
      "properties": {
        "presentationId": {
          "const": "mesh.valtan.sky-axe.descent"
        },
        "combatObjectArchetypeId": {
          "const": "combatobject.valtan.high-jump.target-axe"
        },
        "elementId": {
          "const": "mesh.valtan.sky-axe.descent"
        },
        "disposition": {
          "const": "PRESERVE_EXISTING_OFFICIAL_ASSET_REUSE"
        },
        "modelAssetId": {
          "const": "Character/Valtan/ValtanWeapon.wmodel"
        },
        "bossCatalogEvidence": {
          "const": "BOSS_VALTAN.weaponModel"
        },
        "geometryProvenance": {
          "const": "OFFICIAL_GEOMETRY_EXACT"
        },
        "baseTextureProvenance": {
          "const": "OFFICIAL_MODEL_MATERIAL_BASE_TEXTURE_EXACT"
        },
        "trajectoryTimingProvenance": {
          "const": "EXISTING_HAND_TUNED_PRESERVE"
        },
        "presentationOnly": {
          "const": true
        },
        "serverGameplayChange": {
          "const": false
        }
      }
    }
  }
}
