{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lostark.local/schemas/effect-source-runtime-admission-index-v1.json",
  "title": "LostArk Effect source-runtime admission index",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stableId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])[A-Za-z0-9_.\\-/]+$"
    },
    "countMap": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/stableId"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "denominatorSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stageCount",
        "particleOccurrenceCount",
        "sourceRendererRowCount",
        "currentLegacyComponentCount",
        "currentLegacyEmitterCount"
      ],
      "properties": {
        "stageCount": {
          "type": "integer",
          "minimum": 1
        },
        "particleOccurrenceCount": {
          "type": "integer",
          "minimum": 1
        },
        "sourceRendererRowCount": {
          "type": "integer",
          "minimum": 1
        },
        "currentLegacyComponentCount": {
          "type": "integer",
          "minimum": 1
        },
        "currentLegacyEmitterCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "inputArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "rawSha256",
        "canonicalJsonSha256",
        "roles"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "rawSha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonicalJsonSha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        }
      }
    },
    "componentCue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cueId",
        "componentAssetId",
        "componentPath",
        "componentRawSha256",
        "startDelaySeconds",
        "anchor",
        "localTransformSha256",
        "emitterCount",
        "rendererCounts"
      ],
      "properties": {
        "cueId": {
          "$ref": "#/$defs/stableId"
        },
        "componentAssetId": {
          "$ref": "#/$defs/stableId"
        },
        "componentPath": {
          "$ref": "#/$defs/relativePath"
        },
        "componentRawSha256": {
          "$ref": "#/$defs/sha256"
        },
        "startDelaySeconds": {
          "type": "number"
        },
        "anchor": {
          "$ref": "#/$defs/stableId"
        },
        "localTransformSha256": {
          "$ref": "#/$defs/sha256"
        },
        "emitterCount": {
          "type": "integer",
          "minimum": 1
        },
        "rendererCounts": {
          "$ref": "#/$defs/countMap"
        }
      }
    },
    "currentProduct": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payloadKind",
        "authoringPath",
        "authoringRawSha256",
        "assemblyPath",
        "assemblyRawSha256",
        "componentCues",
        "componentCount",
        "emitterCount",
        "sourceRecipeEnabledEmitterCount"
      ],
      "properties": {
        "payloadKind": {
          "const": "LEGACY_ASSEMBLY_V1"
        },
        "authoringPath": {
          "$ref": "#/$defs/relativePath"
        },
        "authoringRawSha256": {
          "$ref": "#/$defs/sha256"
        },
        "assemblyPath": {
          "$ref": "#/$defs/relativePath"
        },
        "assemblyRawSha256": {
          "$ref": "#/$defs/sha256"
        },
        "componentCues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/componentCue"
          }
        },
        "componentCount": {
          "type": "integer",
          "minimum": 1
        },
        "emitterCount": {
          "type": "integer",
          "minimum": 1
        },
        "sourceRecipeEnabledEmitterCount": {
          "const": 0
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "characterClass",
        "animationAssetId",
        "skillId",
        "inputSlot",
        "skillKind",
        "stageIndex",
        "stageId",
        "clip",
        "productEffectAssetId",
        "importBasisId",
        "timelineOffsetSeconds",
        "durationSeconds",
        "sourceEventIds",
        "sourceRowIds",
        "sourceRowCount",
        "particleOccurrenceIds",
        "particleOccurrenceCount",
        "rendererFamilyCounts",
        "typedDispositionCounts",
        "currentProduct",
        "sourceRuntimeAdmission",
        "productMutation"
      ],
      "properties": {
        "characterClass": {
          "$ref": "#/$defs/stableId"
        },
        "animationAssetId": {
          "$ref": "#/$defs/stableId"
        },
        "skillId": {
          "type": "integer",
          "minimum": 1
        },
        "inputSlot": {
          "const": "LMB"
        },
        "skillKind": {
          "const": "COMBO"
        },
        "stageIndex": {
          "type": "integer",
          "minimum": 0
        },
        "stageId": {
          "$ref": "#/$defs/stableId"
        },
        "clip": {
          "$ref": "#/$defs/stableId"
        },
        "productEffectAssetId": {
          "$ref": "#/$defs/stableId"
        },
        "importBasisId": {
          "$ref": "#/$defs/stableId"
        },
        "timelineOffsetSeconds": {
          "type": "number"
        },
        "durationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sourceEventIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "sourceRowIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "sourceRowCount": {
          "type": "integer",
          "minimum": 1
        },
        "particleOccurrenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "particleOccurrenceCount": {
          "type": "integer",
          "minimum": 1
        },
        "rendererFamilyCounts": {
          "$ref": "#/$defs/countMap"
        },
        "typedDispositionCounts": {
          "$ref": "#/$defs/countMap"
        },
        "currentProduct": {
          "$ref": "#/$defs/currentProduct"
        },
        "sourceRuntimeAdmission": {
          "const": false
        },
        "productMutation": {
          "const": false
        }
      }
    },
    "particleOccurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occurrenceId",
        "characterClass",
        "skillId",
        "stageIndex",
        "stageId",
        "productEffectAssetId",
        "receiptOccurrenceIndex",
        "sourceOccurrenceKey",
        "sourceEventId",
        "sourceTimelineSeconds",
        "stageLocalTimeSeconds",
        "sourceRowIds",
        "sourceRowCount",
        "legacySelectedSourceRowCount",
        "disposition",
        "sourceRuntimeAdmission"
      ],
      "properties": {
        "occurrenceId": {
          "$ref": "#/$defs/stableId"
        },
        "characterClass": {
          "$ref": "#/$defs/stableId"
        },
        "skillId": {
          "type": "integer",
          "minimum": 1
        },
        "stageIndex": {
          "type": "integer",
          "minimum": 0
        },
        "stageId": {
          "$ref": "#/$defs/stableId"
        },
        "productEffectAssetId": {
          "$ref": "#/$defs/stableId"
        },
        "receiptOccurrenceIndex": {
          "type": "integer",
          "minimum": 0
        },
        "sourceOccurrenceKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceEventId": {
          "oneOf": [
            {
              "$ref": "#/$defs/stableId"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceTimelineSeconds": {
          "type": "number"
        },
        "stageLocalTimeSeconds": {
          "type": "number"
        },
        "sourceRowIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "sourceRowCount": {
          "type": "integer",
          "minimum": 1
        },
        "legacySelectedSourceRowCount": {
          "type": "integer",
          "minimum": 0
        },
        "disposition": {
          "enum": [
            "LEGACY_APPROXIMATION",
            "FAIL_CLOSED"
          ]
        },
        "sourceRuntimeAdmission": {
          "const": false
        }
      }
    },
    "stageJoin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sourceEventId",
        "sourceTimelineSeconds"
      ],
      "properties": {
        "kind": {
          "enum": [
            "APPROXIMATION_OCCURRENCE_RECEIPT",
            "SOURCE_EVENT_ID",
            "SOURCE_TIMELINE_INTERVAL"
          ]
        },
        "sourceEventId": {
          "oneOf": [
            {
              "$ref": "#/$defs/stableId"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceTimelineSeconds": {
          "type": "number"
        }
      }
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attachmentSha256",
        "enabled",
        "follow",
        "sourceAnchorSlotId",
        "runtimeAnchorSlotId",
        "runtimeBoneName",
        "importBasisId",
        "assetBasisStatus"
      ],
      "properties": {
        "attachmentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "enabled": {
          "type": "boolean"
        },
        "follow": {
          "type": "boolean"
        },
        "sourceAnchorSlotId": {
          "type": "string"
        },
        "runtimeAnchorSlotId": {
          "type": "string"
        },
        "runtimeBoneName": {
          "type": "string"
        },
        "importBasisId": {
          "$ref": "#/$defs/stableId"
        },
        "assetBasisStatus": {
          "enum": [
            "UNRESOLVED_FAIL_CLOSED",
            "SOURCE_EVIDENCE_PINNED"
          ]
        }
      }
    },
    "sourceRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "rendererShape",
        "sourceRecipeSha256",
        "moduleClosureSha256",
        "moduleCount",
        "moduleStableIds"
      ],
      "properties": {
        "enabled": {
          "const": true
        },
        "rendererShape": {
          "$ref": "#/$defs/stableId"
        },
        "sourceRecipeSha256": {
          "$ref": "#/$defs/sha256"
        },
        "moduleClosureSha256": {
          "$ref": "#/$defs/sha256"
        },
        "moduleCount": {
          "type": "integer",
          "minimum": 1
        },
        "moduleStableIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "materialRecipeId",
        "materialRecipeSha256",
        "sourceMaterialPath",
        "renderProfile",
        "sourceProfileEnabled",
        "materialFamilyId",
        "runtimeShaderProfileId",
        "staticSetSha256",
        "textureEvidenceSha256",
        "shaderBinding"
      ],
      "properties": {
        "materialRecipeId": {
          "$ref": "#/$defs/stableId"
        },
        "materialRecipeSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceMaterialPath": {
          "type": "string",
          "minLength": 1
        },
        "renderProfile": {
          "$ref": "#/$defs/stableId"
        },
        "sourceProfileEnabled": {
          "type": "boolean"
        },
        "materialFamilyId": {
          "oneOf": [
            {
              "$ref": "#/$defs/stableId"
            },
            {
              "type": "null"
            }
          ]
        },
        "runtimeShaderProfileId": {
          "oneOf": [
            {
              "$ref": "#/$defs/stableId"
            },
            {
              "type": "null"
            }
          ]
        },
        "staticSetSha256": {
          "$ref": "#/$defs/sha256"
        },
        "textureEvidenceSha256": {
          "$ref": "#/$defs/sha256"
        },
        "shaderBinding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "vfId",
            "passIndex",
            "staticSetSha256"
          ],
          "properties": {
            "status": {
              "enum": [
                "SOURCE_PROFILE_DISABLED",
                "RECONSTRUCTED_PROFILE_WITHOUT_OCCURRENCE_VF_PASS"
              ]
            },
            "vfId": {
              "type": "null"
            },
            "passIndex": {
              "type": "null"
            },
            "staticSetSha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "resourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slotId",
        "assetId"
      ],
      "properties": {
        "slotId": {
          "$ref": "#/$defs/stableId"
        },
        "assetId": {
          "type": "string",
          "pattern": "^Effect/(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])[A-Za-z0-9_.\\-/]+$"
        }
      }
    },
    "legacyProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectionDecision",
        "targetElementId",
        "targetElementSha256",
        "rejectionReason",
        "evidenceReasonCodes"
      ],
      "properties": {
        "selectionDecision": {
          "enum": [
            "selected",
            "rejected",
            "budgetExcluded",
            "notApplicable"
          ]
        },
        "targetElementId": {
          "oneOf": [
            {
              "$ref": "#/$defs/stableId"
            },
            {
              "type": "null"
            }
          ]
        },
        "targetElementSha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "rejectionReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidenceReasonCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rowAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "sourceRuntimeAdmission",
        "sourceProductAdmission",
        "preservesCurrentLegacyProduct",
        "blockers"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "NATIVE_EXACT",
            "TYPED_RECONSTRUCTED",
            "LEGACY_APPROXIMATION",
            "INTENTIONAL_NONPRODUCT",
            "FAIL_CLOSED"
          ]
        },
        "sourceRuntimeAdmission": {
          "const": false
        },
        "sourceProductAdmission": {
          "const": false
        },
        "preservesCurrentLegacyProduct": {
          "type": "boolean"
        },
        "blockers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        }
      }
    },
    "sourceRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRowId",
        "characterClass",
        "animationAssetId",
        "skillId",
        "stageIndex",
        "stageId",
        "clip",
        "productEffectAssetId",
        "sourceElementId",
        "sourceElementSha256",
        "sourceOrder",
        "sourceKind",
        "rendererFamily",
        "sourceEventId",
        "sourceActionCueId",
        "sourcePresentationOccurrenceIndex",
        "particleOccurrenceId",
        "stageJoin",
        "importBasisId",
        "attachment",
        "sourceRecipe",
        "material",
        "resourceBindings",
        "resourceBindingsSha256",
        "legacyProjection",
        "admission"
      ],
      "properties": {
        "sourceRowId": {
          "$ref": "#/$defs/stableId"
        },
        "characterClass": {
          "$ref": "#/$defs/stableId"
        },
        "animationAssetId": {
          "$ref": "#/$defs/stableId"
        },
        "skillId": {
          "type": "integer",
          "minimum": 1
        },
        "stageIndex": {
          "type": "integer",
          "minimum": 0
        },
        "stageId": {
          "$ref": "#/$defs/stableId"
        },
        "clip": {
          "$ref": "#/$defs/stableId"
        },
        "productEffectAssetId": {
          "$ref": "#/$defs/stableId"
        },
        "sourceElementId": {
          "type": "string",
          "minLength": 1
        },
        "sourceElementSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceOrder": {
          "type": "integer",
          "minimum": 0
        },
        "sourceKind": {
          "enum": [
            "particle",
            "decal",
            "light",
            "screenPost"
          ]
        },
        "rendererFamily": {
          "enum": [
            "MESH_PARTICLE",
            "SPRITE_PARTICLE",
            "DECAL_PARTICLE",
            "CASCADE_RIBBON",
            "LIGHT_PARTICLE",
            "SCREEN_POST"
          ]
        },
        "sourceEventId": {
          "oneOf": [
            {
              "$ref": "#/$defs/stableId"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceActionCueId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourcePresentationOccurrenceIndex": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "particleOccurrenceId": {
          "oneOf": [
            {
              "$ref": "#/$defs/stableId"
            },
            {
              "type": "null"
            }
          ]
        },
        "stageJoin": {
          "$ref": "#/$defs/stageJoin"
        },
        "importBasisId": {
          "$ref": "#/$defs/stableId"
        },
        "attachment": {
          "$ref": "#/$defs/attachment"
        },
        "sourceRecipe": {
          "$ref": "#/$defs/sourceRecipe"
        },
        "material": {
          "$ref": "#/$defs/material"
        },
        "resourceBindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceBinding"
          }
        },
        "resourceBindingsSha256": {
          "$ref": "#/$defs/sha256"
        },
        "legacyProjection": {
          "$ref": "#/$defs/legacyProjection"
        },
        "admission": {
          "$ref": "#/$defs/rowAdmission"
        }
      }
    },
    "classSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "characterClass",
        "animationAssetId",
        "skillId",
        "stageCount",
        "particleOccurrenceCount",
        "sourceRendererRowCount",
        "rendererFamilyCounts",
        "typedDispositionCounts",
        "currentLegacyComponentCount",
        "currentLegacyEmitterCount"
      ],
      "properties": {
        "characterClass": {
          "$ref": "#/$defs/stableId"
        },
        "animationAssetId": {
          "$ref": "#/$defs/stableId"
        },
        "skillId": {
          "type": "integer",
          "minimum": 1
        },
        "stageCount": {
          "type": "integer",
          "minimum": 1
        },
        "particleOccurrenceCount": {
          "type": "integer",
          "minimum": 1
        },
        "sourceRendererRowCount": {
          "type": "integer",
          "minimum": 1
        },
        "rendererFamilyCounts": {
          "$ref": "#/$defs/countMap"
        },
        "typedDispositionCounts": {
          "$ref": "#/$defs/countMap"
        },
        "currentLegacyComponentCount": {
          "type": "integer",
          "minimum": 1
        },
        "currentLegacyEmitterCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "formatVersion",
    "indexId",
    "contractRole",
    "scope",
    "schemaIdentity",
    "builderIdentity",
    "importBasisContract",
    "inputArtifacts",
    "stages",
    "particleOccurrences",
    "sourceRows",
    "denominators",
    "rendererFamilyCounts",
    "typedDispositionCounts",
    "legacySelectionCounts",
    "classSummaries",
    "admission",
    "transactionPolicy",
    "artifactSha256"
  ],
  "properties": {
    "schema": {
      "const": "lostark.effect-source-runtime-admission-index"
    },
    "formatVersion": {
      "const": 1
    },
    "indexId": {
      "$ref": "#/$defs/stableId"
    },
    "contractRole": {
      "const": "EVIDENCE_JOIN_NOT_RUNTIME_AUTHORITY"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputSlot",
        "skillKind",
        "characterClasses",
        "expectedDenominators"
      ],
      "properties": {
        "inputSlot": {
          "const": "LMB"
        },
        "skillKind": {
          "const": "COMBO"
        },
        "characterClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "expectedDenominators": {
          "$ref": "#/$defs/denominatorSet"
        }
      }
    },
    "schemaIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "rawSha256",
        "canonicalJsonSha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "rawSha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonicalJsonSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "builderIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "rawSha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "rawSha256": {
