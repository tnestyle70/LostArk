{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lostark.local/schemas/effect-authored-import-batch-v1.json",
  "title": "LostArk four-class Track A authored import batch",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stableId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])[A-Za-z0-9_.\\-/]+$"
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "rawSha256",
        "canonicalJsonSha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "rawSha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonicalJsonSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "importedDocumentReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "rawSha256",
        "canonicalJsonSha256",
        "effectAssetId"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "rawSha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonicalJsonSha256": {
          "$ref": "#/$defs/sha256"
        },
        "effectAssetId": {
          "$ref": "#/$defs/stableId"
        }
      }
    },
    "inputArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "rawSha256",
        "canonicalJsonSha256",
        "roles"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "rawSha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonicalJsonSha256": {
          "$ref": "#/$defs/sha256"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        }
      }
    },
    "countMap": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/stableId"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "sourceArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "sourceReceipt",
        "importedDocument",
        "conversionReceipt"
      ],
      "properties": {
        "manifest": {
          "$ref": "#/$defs/artifactReference"
        },
        "sourceReceipt": {
          "$ref": "#/$defs/artifactReference"
        },
        "importedDocument": {
          "$ref": "#/$defs/importedDocumentReference"
        },
        "conversionReceipt": {
          "$ref": "#/$defs/artifactReference"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "artifact",
        "recordId",
        "recordSha256",
        "sourceSelectionReceipt"
      ],
      "properties": {
        "kind": {
          "enum": [
            "TRACK_A_VISUAL_PROGRAM",
            "WARLORD_FAIL_CLOSED_CANARY"
          ]
        },
        "artifact": {
          "$ref": "#/$defs/artifactReference"
        },
        "recordId": {
          "$ref": "#/$defs/stableId"
        },
        "recordSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceSelectionReceipt": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifactReference"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "legacyRollbackBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "effectAssetId",
        "rawSha256",
        "canonicalJsonSha256",
        "authoringVersion",
        "policy"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "effectAssetId": {
          "$ref": "#/$defs/stableId"
        },
        "rawSha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonicalJsonSha256": {
          "$ref": "#/$defs/sha256"
        },
        "authoringVersion": {
          "type": "integer",
          "minimum": 1
        },
        "policy": {
          "const": "IMMUTABLE_LEGACY_ROLLBACK_EXACT"
        }
      }
    },
    "candidateBaseline": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy",
            "expectedRawSha256",
            "expectedCanonicalJsonSha256",
            "authoringVersion"
          ],
          "properties": {
            "policy": { "const": "MUST_NOT_EXIST" },
            "expectedRawSha256": { "type": "null" },
            "expectedCanonicalJsonSha256": { "type": "null" },
            "authoringVersion": { "type": "null" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy",
            "expectedRawSha256",
            "expectedCanonicalJsonSha256",
            "authoringVersion"
          ],
          "properties": {
            "policy": { "const": "EXPECTED_EXACT_OR_REFUSE" },
            "expectedRawSha256": { "$ref": "#/$defs/sha256" },
            "expectedCanonicalJsonSha256": { "$ref": "#/$defs/sha256" },
            "authoringVersion": { "enum": [12, 13] }
          }
        }
      ]
    },
    "targetBlueprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "authoringVersion",
        "canonicalJsonSha256",
        "typedCodecSha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "VISUAL_PROGRAM_PROJECTED_DOCUMENT",
            "CURRENT_AUTHORED_BASELINE"
          ]
        },
        "authoringVersion": {
          "type": "integer",
          "minimum": 1
        },
        "canonicalJsonSha256": {
          "$ref": "#/$defs/sha256"
        },
        "typedCodecSha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "targetDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "effectAssetId",
        "requiredOutputVersion",
        "candidateBaseline",
        "legacyRollbackBaseline",
        "blueprint"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "effectAssetId": {
          "$ref": "#/$defs/stableId"
        },
        "requiredOutputVersion": {
          "const": 13
        },
        "candidateBaseline": {
          "$ref": "#/$defs/candidateBaseline"
        },
        "legacyRollbackBaseline": {
          "$ref": "#/$defs/legacyRollbackBaseline"
        },
        "blueprint": {
          "$ref": "#/$defs/targetBlueprint"
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stageKey",
        "mode",
        "characterClass",
        "animationAssetId",
        "skillId",
        "inputSlot",
        "skillKind",
        "stageIndex",
        "stageId",
        "clip",
        "sourceArtifacts",
        "selection",
        "target",
        "elementPlanIds",
        "elementPlanCount",
        "materialDispositionCounts",
        "carrierDispositionCounts",
        "productMutation",
        "visualApproval"
      ],
      "properties": {
        "stageKey": {
          "$ref": "#/$defs/stableId"
        },
        "mode": {
          "enum": [
            "TRACK_A_VISUAL_PROGRAM",
            "WARLORD_FAIL_CLOSED_CANARY"
          ]
        },
        "characterClass": {
          "enum": [
            "ARTIST",
            "DIMENSIONMASTER",
            "LANCE_MASTER",
            "WARLORD"
          ]
        },
        "animationAssetId": {
          "$ref": "#/$defs/stableId"
        },
        "skillId": {
          "type": "integer",
          "minimum": 1
        },
        "inputSlot": {
          "const": "LMB"
        },
        "skillKind": {
          "const": "COMBO"
        },
        "stageIndex": {
          "type": "integer",
          "minimum": 0
        },
        "stageId": {
          "$ref": "#/$defs/stableId"
        },
        "clip": {
          "$ref": "#/$defs/stableId"
        },
        "sourceArtifacts": {
          "$ref": "#/$defs/sourceArtifacts"
        },
        "selection": {
          "$ref": "#/$defs/selection"
        },
        "target": {
          "$ref": "#/$defs/targetDocument"
        },
        "elementPlanIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "elementPlanCount": {
          "type": "integer",
          "minimum": 1
        },
        "materialDispositionCounts": {
          "$ref": "#/$defs/countMap"
        },
        "carrierDispositionCounts": {
          "$ref": "#/$defs/countMap"
        },
        "productMutation": {
          "const": false
        },
        "visualApproval": {
          "const": false
        }
      }
    },
    "importedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "documentPath",
        "documentRawSha256",
        "effectAssetId",
        "elementId",
        "elementCanonicalSha256",
        "sourceRecipeCanonicalSha256",
        "sourceDetailCanonicalSha256",
        "sourceAttachmentCanonicalSha256",
        "sourceEventId"
      ],
      "properties": {
        "kind": {
          "const": "IMPORTED_ELEMENT"
        },
        "documentPath": {
          "$ref": "#/$defs/relativePath"
        },
        "documentRawSha256": {
          "$ref": "#/$defs/sha256"
        },
        "effectAssetId": {
          "$ref": "#/$defs/stableId"
        },
        "elementId": {
          "$ref": "#/$defs/stableId"
        },
        "elementCanonicalSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceRecipeCanonicalSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceDetailCanonicalSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceAttachmentCanonicalSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceEventId": {
          "oneOf": [
            {
              "$ref": "#/$defs/stableId"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "supplementalSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "recordId",
        "recordCanonicalSha256",
        "sourceEventId"
      ],
      "properties": {
        "kind": {
          "const": "VISUAL_PROGRAM_SUPPLEMENTAL"
        },
        "recordId": {
          "$ref": "#/$defs/stableId"
        },
        "recordCanonicalSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceEventId": {
          "$ref": "#/$defs/stableId"
        }
      }
    },
    "targetElement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentPath",
        "effectAssetId",
        "elementId",
        "groupId",
        "displayName",
        "blueprintElementCanonicalSha256",
        "baselineElementCanonicalSha256",
        "targetDetailCanonicalSha256"
      ],
      "properties": {
        "documentPath": {
          "$ref": "#/$defs/relativePath"
        },
        "effectAssetId": {
          "$ref": "#/$defs/stableId"
        },
        "elementId": {
          "$ref": "#/$defs/stableId"
        },
        "groupId": {
          "$ref": "#/$defs/stableId"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "blueprintElementCanonicalSha256": {
          "$ref": "#/$defs/sha256"
        },
        "baselineElementCanonicalSha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "targetDetailCanonicalSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "selectionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordId",
        "recordSha256"
      ],
      "properties": {
        "recordId": {
          "$ref": "#/$defs/stableId"
        },
        "recordSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "carrierDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "blockers"
      ],
      "properties": {
        "kind": {
          "enum": [
            "GENERIC_PARTICLE_IMPORT_CANDIDATE",
            "FAMILY_ADAPTER_REQUIRED",
            "SUPPLEMENTAL_ADAPTER_PRESERVE"
          ]
        },
        "blockers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        }
      }
    },
    "typedExecutionDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "executionSnapshotSha256"
      ],
      "properties": {
        "kind": {
          "const": "TYPED_EXECUTION"
        },
        "executionSnapshotSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sourceProfileDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sourceProfileSha256",
        "profileId",
        "runtimeShaderProfileId"
      ],
      "properties": {
        "kind": {
          "const": "ADMITTED_SOURCE_PROFILE"
        },
        "sourceProfileSha256": {
          "$ref": "#/$defs/sha256"
        },
        "profileId": {
          "$ref": "#/$defs/stableId"
        },
        "runtimeShaderProfileId": {
          "$ref": "#/$defs/stableId"
        }
      }
    },
    "failClosedMaterialDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "blockers"
      ],
      "properties": {
        "kind": {
          "const": "FAIL_CLOSED"
        },
        "blockers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        }
      }
    },
    "materialDisposition": {
      "oneOf": [
        {
          "$ref": "#/$defs/typedExecutionDisposition"
        },
        {
          "$ref": "#/$defs/sourceProfileDisposition"
        },
        {
          "$ref": "#/$defs/failClosedMaterialDisposition"
        }
      ]
    },
    "elementPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planId",
        "stageKey",
        "source",
        "target",
        "selectionIdentity",
        "family",
        "carrierDisposition",
        "materialDisposition",
        "productMutation",
        "visualApproval"
      ],
      "properties": {
        "planId": {
          "$ref": "#/$defs/stableId"
        },
        "stageKey": {
          "$ref": "#/$defs/stableId"
        },
        "source": {
          "oneOf": [
            {
              "$ref": "#/$defs/importedSource"
            },
            {
              "$ref": "#/$defs/supplementalSource"
            }
          ]
        },
        "target": {
          "$ref": "#/$defs/targetElement"
        },
        "selectionIdentity": {
          "$ref": "#/$defs/selectionIdentity"
        },
        "family": {
          "$ref": "#/$defs/stableId"
        },
        "carrierDisposition": {
          "$ref": "#/$defs/carrierDisposition"
        },
        "materialDisposition": {
          "$ref": "#/$defs/materialDisposition"
        },
        "productMutation": {
          "const": false
        },
        "visualApproval": {
          "const": false
        }
      }
    },
    "legacyStarterClip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clip",
        "stageClipIndex",
        "status",
        "legacyEffectAssetId",
        "candidateEffectAssetId"
      ],
      "properties": {
        "clip": { "$ref": "#/$defs/stableId" },
        "stageClipIndex": { "type": "integer", "minimum": 0 },
        "status": {
          "enum": [
            "visualBearing",
            "noSelectedCarrier",
            "sourceIntentionallySilent"
          ]
        },
        "legacyEffectAssetId": {
          "oneOf": [
            { "$ref": "#/$defs/stableId" },
            { "type": "null" }
          ]
        },
        "candidateEffectAssetId": {
          "oneOf": [
            { "$ref": "#/$defs/stableId" },
            { "type": "null" }
          ]
        }
      }
    },
    "legacyStarterStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stageKey",
        "mode",
        "characterClass",
        "animationAssetId",
        "skillId",
        "inputSlot",
        "skillKind",
        "stageIndex",
        "stageId",
        "status",
        "sourceManifest",
        "rolloutStageCanonicalSha256",
        "clips",
        "candidateEffectAssetIds",
        "blockers",
        "productMutation",
        "visualApproval"
      ],
      "properties": {
        "stageKey": { "$ref": "#/$defs/stableId" },
        "mode": { "enum": ["LEGACY_STARTER_STAGE", "INTENTIONALLY_SILENT"] },
        "characterClass": {
          "enum": ["ARTIST", "DIMENSIONMASTER", "LANCE_MASTER", "WARLORD"]
        },
        "animationAssetId": { "$ref": "#/$defs/stableId" },
        "skillId": { "type": "integer", "minimum": 1 },
        "inputSlot": { "$ref": "#/$defs/stableId" },
        "skillKind": { "$ref": "#/$defs/stableId" },
        "stageIndex": { "type": "integer", "minimum": 0 },
        "stageId": { "$ref": "#/$defs/stableId" },
        "status": { "enum": ["effectBearing", "sourceIntentionallySilent"] },
        "sourceManifest": { "$ref": "#/$defs/artifactReference" },
        "rolloutStageCanonicalSha256": { "$ref": "#/$defs/sha256" },
        "clips": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/legacyStarterClip" }
        },
        "candidateEffectAssetIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "blockers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "productMutation": { "const": false },
        "visualApproval": { "const": false }
      }
    },
    "extendedDocumentReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "rawSha256",
        "canonicalJsonSha256",
        "effectAssetId",
        "authoringVersion"
      ],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "rawSha256": { "$ref": "#/$defs/sha256" },
        "canonicalJsonSha256": { "$ref": "#/$defs/sha256" },
        "effectAssetId": { "$ref": "#/$defs/stableId" },
        "authoringVersion": { "enum": [12, 13] }
      }
    },
    "legacyStarterRollback": {
      "allOf": [
        { "$ref": "#/$defs/extendedDocumentReference" },
        {
          "type": "object",
          "required": [
            "policy",
            "rolloutDocumentFileSha256",
            "rolloutHashDisposition"
          ],
          "properties": {
            "policy": { "const": "IMMUTABLE_LEGACY_ROLLBACK_EXACT" },
            "rolloutDocumentFileSha256": { "$ref": "#/$defs/sha256" },
            "rolloutHashDisposition": {
              "enum": ["EXACT_RAW", "EOL_NORMALIZED_MATCH"]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "legacyStarterSelectedSource": {
      "allOf": [
        { "$ref": "#/$defs/extendedDocumentReference" },
        {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {
              "enum": ["IMMUTABLE_LEGACY_ROLLBACK", "EXISTING_UNIFIED_CANDIDATE"]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "legacyStarterTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "effectAssetId",
        "requiredOutputVersion",
        "candidateBaseline"
      ],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "effectAssetId": { "$ref": "#/$defs/stableId" },
        "requiredOutputVersion": { "const": 13 },
        "candidateBaseline": { "$ref": "#/$defs/candidateBaseline" }
      }
    },
    "legacyStarterProductReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalogPath",
        "catalogEntryCanonicalSha256",
        "animeventPath",
        "animeventRawSha256",
        "activeReferenceCount",
        "orphanedCatalogReference"
      ],
      "properties": {
        "catalogPath": { "$ref": "#/$defs/relativePath" },
        "catalogEntryCanonicalSha256": { "$ref": "#/$defs/sha256" },
        "animeventPath": { "$ref": "#/$defs/relativePath" },
        "animeventRawSha256": { "$ref": "#/$defs/sha256" },
        "activeReferenceCount": { "type": "integer", "minimum": 0, "maximum": 1 },
        "orphanedCatalogReference": { "type": "boolean" }
      }
    },
    "legacyStarterCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateKey",
        "characterClass",
        "animationAssetId",
        "skillId",
        "stageIndex",
        "stageClipIndex",
        "clip",
        "legacyRollbackBaseline",
        "starterSource",
        "target",
        "productReference",
        "rolloutRecordCanonicalSha256",
        "disposition",
        "trackAAdmission",
        "productMutation",
        "visualApproval"
      ],
      "properties": {
        "candidateKey": { "$ref": "#/$defs/stableId" },
        "characterClass": {
          "enum": ["ARTIST", "DIMENSIONMASTER", "LANCE_MASTER", "WARLORD"]
        },
        "animationAssetId": { "$ref": "#/$defs/stableId" },
        "skillId": { "type": "integer", "minimum": 1 },
        "stageIndex": { "type": "integer", "minimum": 0 },
        "stageClipIndex": { "type": "integer", "minimum": 0 },
        "clip": { "$ref": "#/$defs/stableId" },
        "legacyRollbackBaseline": { "$ref": "#/$defs/legacyStarterRollback" },
        "starterSource": { "$ref": "#/$defs/legacyStarterSelectedSource" },
        "target": { "$ref": "#/$defs/legacyStarterTarget" },
        "productReference": { "$ref": "#/$defs/legacyStarterProductReference" },
        "rolloutRecordCanonicalSha256": { "$ref": "#/$defs/sha256" },
        "disposition": {
          "type": "object",
