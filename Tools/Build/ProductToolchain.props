<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" InitialTargets="ValidateLostArkProductToolchain">
  <!-- Select the host before Microsoft.Cpp.props resolves compiler and SDK paths. -->
  <PropertyGroup>
    <LostArkProductX64Toolchain Condition="'$(MSBuildProjectExtension)'=='.vcxproj' and '$(Platform)'=='x64' and ('$(MSBuildProjectName)'=='Engine' or '$(MSBuildProjectName)'=='Client' or '$(MSBuildProjectName)'=='Shared' or '$(MSBuildProjectName)'=='Server')">true</LostArkProductX64Toolchain>
  </PropertyGroup>
  <PropertyGroup Condition="'$(LostArkProductX64Toolchain)'=='true'">
    <PreferredToolArchitecture>x64</PreferredToolArchitecture>
    <WindowsSDKToolArchitecture>Native64Bit</WindowsSDKToolArchitecture>
  </PropertyGroup>
  <!-- InitialTargets runs before PrepareForBuild can write shared tracking state. -->
  <Target Name="ValidateLostArkProductToolchain" Condition="'$(LostArkProductX64Toolchain)'=='true'">
    <Error Code="LARKBUILD001"
           Condition="'$(PreferredToolArchitecture)'!='x64' or '$(VCToolArchitecture)'!='Native64Bit' or '$(WindowsSDKToolArchitecture)'!='Native64Bit' or ('$(FxCompileToolArchitecture)'!='' and '$(FxCompileToolArchitecture)'!='Native64Bit')"
           Text="LostArk product x64 builds require compiler and Windows SDK hosts x64/Native64Bit. Remove conflicting PreferredToolArchitecture, VCToolArchitecture, WindowsSDKToolArchitecture or FxCompileToolArchitecture overrides before using the shared product output directories." />
  </Target>
</Project>
