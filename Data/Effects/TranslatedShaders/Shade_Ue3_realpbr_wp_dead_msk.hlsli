    float stage131_y = cb0[8].w * r4.y + cb0[8].y;
    float stage131_z = cb0[8].w * r4.z + cb0[8].z;
    r4.x = stage131_x;
    r4.y = stage131_y;
    r4.z = stage131_z;
    // mad r1.w, cb0[7].w, r2.w, r2.z
    r1.w = cb0[7].w * r2.w + r2.z;
    // mad r4.xyz, r1.wwww, cb0[7].xyzx, r4.xyzx
    float stage132_x = r1.w * cb0[7].x + r4.x;
    float stage132_y = r1.w * cb0[7].y + r4.y;
    float stage132_z = r1.w * cb0[7].z + r4.z;
    r4.x = stage132_x;
    r4.y = stage132_y;
    r4.z = stage132_z;
    // log r1.w, |r0.w|
    r1.w = log2(abs(r0.w));
    // lt r0.w, |r0.w|, l(0.000001)
    r0.w = asfloat((abs(r0.w) < 1e-06f) ? 0xffffffffu : 0u);
    // mul r1.w, r1.w, l(1.500000)
    r1.w = r1.w * 1.5f;
    // exp r1.w, r1.w
    r1.w = exp2(r1.w);
    // mul r5.xyz, r1.wwww, cb0[9].xyzx
    float stage133_x = r1.w * cb0[9].x;
    float stage133_y = r1.w * cb0[9].y;
    float stage133_z = r1.w * cb0[9].z;
    r5.x = stage133_x;
    r5.y = stage133_y;
    r5.z = stage133_z;
    // movc r5.xyz, r0.wwww, l(0,0,0,0), r5.xyzx
    float stage134_x = asuint(r0.w) != 0u ? asfloat(0u) : r5.x;
    float stage134_y = asuint(r0.w) != 0u ? asfloat(0u) : r5.y;
    float stage134_z = asuint(r0.w) != 0u ? asfloat(0u) : r5.z;
    r5.x = stage134_x;
    r5.y = stage134_y;
    r5.z = stage134_z;
    // add r4.xyz, r4.xyzx, r5.xyzx
    float stage135_x = r4.x + r5.x;
    float stage135_y = r4.y + r5.y;
    float stage135_z = r4.z + r5.z;
    r4.x = stage135_x;
    r4.y = stage135_y;
    r4.z = stage135_z;
    // mad r1.xyz, cb0[13].zzzz, r1.xyzx, r4.xyzx
    float stage136_x = cb0[13].z * r1.x + r4.x;
    float stage136_y = cb0[13].z * r1.y + r4.y;
    float stage136_z = cb0[13].z * r1.z + r4.z;
    r1.x = stage136_x;
    r1.y = stage136_y;
    r1.z = stage136_z;
    // add r1.xyz, r1.xyzx, cb0[2].xyzx
    float stage137_x = r1.x + cb0[2].x;
    float stage137_y = r1.y + cb0[2].y;
    float stage137_z = r1.z + cb0[2].z;
    r1.x = stage137_x;
    r1.y = stage137_y;
    r1.z = stage137_z;
    // mul r4.xyz, r6.wwww, cb0[28].xyzx
    float stage138_x = r6.w * cb0[28].x;
    float stage138_y = r6.w * cb0[28].y;
    float stage138_z = r6.w * cb0[28].z;
    r4.x = stage138_x;
    r4.y = stage138_y;
    r4.z = stage138_z;
    // mad r4.xyz, r6.zzzz, cb0[27].xyzx, r4.xyzx
    float stage139_x = r6.z * cb0[27].x + r4.x;
    float stage139_y = r6.z * cb0[27].y + r4.y;
    float stage139_z = r6.z * cb0[27].z + r4.z;
    r4.x = stage139_x;
    r4.y = stage139_y;
    r4.z = stage139_z;
    // mul r4.xyz, r4.xyzx, cb0[29].wwww
    float stage140_x = r4.x * cb0[29].w;
    float stage140_y = r4.y * cb0[29].w;
    float stage140_z = r4.z * cb0[29].w;
    r4.x = stage140_x;
    r4.y = stage140_y;
    r4.z = stage140_z;
    // mul_sat r5.xyz, cb0[12].xyzx, cb0[12].wwww
    float stage141_x = saturate(cb0[12].x * cb0[12].w);
    float stage141_y = saturate(cb0[12].y * cb0[12].w);
    float stage141_z = saturate(cb0[12].z * cb0[12].w);
    r5.x = stage141_x;
    r5.y = stage141_y;
    r5.z = stage141_z;
    // mul r2.xzw, r2.xxxx, r5.xxyz
    float stage142_x = r2.x * r5.x;
    float stage142_z = r2.x * r5.y;
    float stage142_w = r2.x * r5.z;
    r2.x = stage142_x;
    r2.z = stage142_z;
    r2.w = stage142_w;
    // mul r5.xyz, r5.xyzx, cb0[16].wwww
    float stage143_x = r5.x * cb0[16].w;
    float stage143_y = r5.y * cb0[16].w;
    float stage143_z = r5.z * cb0[16].w;
    r5.x = stage143_x;
    r5.y = stage143_y;
    r5.z = stage143_z;
    // dp3_sat o5.x, r5.xyzx, l(0.300000, 0.590000, 0.110000, 0.000000)
    o5.x = saturate(dot(r5.xyz, float3(0.3f, 0.59f, 0.11f)));
    // mul r2.xyz, r2.yyyy, r2.xzwx
    float stage144_x = r2.y * r2.x;
    float stage144_y = r2.y * r2.z;
    float stage144_z = r2.y * r2.w;
    r2.x = stage144_x;
    r2.y = stage144_y;
    r2.z = stage144_z;
    // mul r2.xyz, r2.xyzx, r4.xyzx
    float stage145_x = r2.x * r4.x;
    float stage145_y = r2.y * r4.y;
    float stage145_z = r2.z * r4.z;
    r2.x = stage145_x;
    r2.y = stage145_y;
    r2.z = stage145_z;
    // mul r2.xyz, r3.xyzx, r2.xyzx
    float stage146_x = r3.x * r2.x;
    float stage146_y = r3.y * r2.y;
    float stage146_z = r3.z * r2.z;
    r2.x = stage146_x;
    r2.y = stage146_y;
    r2.z = stage146_z;
    // mad r1.xyz, r2.xyzx, l(0.600000, 0.600000, 0.600000, 0.000000), r1.xyzx
    float stage147_x = r2.x * 0.6f + r1.x;
    float stage147_y = r2.y * 0.6f + r1.y;
    float stage147_z = r2.z * 0.6f + r1.z;
    r1.x = stage147_x;
    r1.y = stage147_y;
    r1.z = stage147_z;
    // add r1.xyz, r0.xyzx, r1.xyzx
    float stage148_x = r0.x + r1.x;
    float stage148_y = r0.y + r1.y;
    float stage148_z = r0.z + r1.z;
    r1.x = stage148_x;
    r1.y = stage148_y;
    r1.z = stage148_z;
    // dp3 o4.y, r0.xyzx, l(0.300000, 0.590000, 0.110000, 0.000000)
    o4.y = dot(r0.xyz, float3(0.3f, 0.59f, 0.11f));
    // mad o0.xyz, r3.xyzx, cb0[29].xyzx, r1.xyzx
    float stage149_x = r3.x * cb0[29].x + r1.x;
    float stage149_y = r3.y * cb0[29].y + r1.y;
    float stage149_z = r3.z * cb0[29].z + r1.z;
    o0.x = stage149_x;
    o0.y = stage149_y;
    o0.z = stage149_z;
    // mov o0.w, l(0)
    o0.w = asfloat(0u);
    // dp3 r0.x, r15.xyzx, r15.xyzx
    r0.x = dot(r15.xyz, r15.xyz);
    // rsq r0.x, r0.x
    r0.x = rsqrt(r0.x);
    // mul r0.xyz, r0.xxxx, r15.xyzx
    float stage150_x = r0.x * r15.x;
    float stage150_y = r0.x * r15.y;
    float stage150_z = r0.x * r15.z;
    r0.x = stage150_x;
    r0.y = stage150_y;
    r0.z = stage150_z;
    // ge r0.w, l(0.000000), r0.z
    r0.w = asfloat((0.0f >= r0.z) ? 0xffffffffu : 0u);
    // dp3 r0.z, l(1.000000, 1.000000, 1.000000, 0.000000), |r0.xyzx|
    r0.z = dot(float3(1.0f, 1.0f, 1.0f), abs(r0.xyz));
    // div r0.xy, r0.xyxx, r0.zzzz
    float stage151_x = r0.x / r0.z;
    float stage151_y = r0.y / r0.z;
    r0.x = stage151_x;
    r0.y = stage151_y;
    // ge r1.xy, r0.xyxx, l(0.000000, 0.000000, 0.000000, 0.000000)
    float stage152_x = asfloat((r0.x >= 0.0f) ? 0xffffffffu : 0u);
    float stage152_y = asfloat((r0.y >= 0.0f) ? 0xffffffffu : 0u);
    r1.x = stage152_x;
    r1.y = stage152_y;
    // movc r1.xy, r1.xyxx, l(1.000000,1.000000,0,0), l(-1.000000,-1.000000,0,0)
    float stage153_x = asuint(r1.x) != 0u ? 1.0f : -1.0f;
    float stage153_y = asuint(r1.y) != 0u ? 1.0f : -1.0f;
    r1.x = stage153_x;
    r1.y = stage153_y;
    // mad r1.xy, -|r0.yxyy|, r1.xyxx, r1.xyxx
    float stage154_x = -(abs(r0.y)) * r1.x + r1.x;
    float stage154_y = -(abs(r0.x)) * r1.y + r1.y;
    r1.x = stage154_x;
    r1.y = stage154_y;
    // movc r0.xy, r0.wwww, r1.xyxx, r0.xyxx
    float stage155_x = asuint(r0.w) != 0u ? r1.x : r0.x;
    float stage155_y = asuint(r0.w) != 0u ? r1.y : r0.y;
    r0.x = stage155_x;
    r0.y = stage155_y;
    // mad o2.xy, r0.xyxx, l(0.500000, 0.500000, 0.000000, 0.000000), l(0.500000, 0.500000, 0.000000, 0.000000)
    float stage156_x = r0.x * 0.5f + 0.5f;
    float stage156_y = r0.y * 0.5f + 0.5f;
    o2.x = stage156_x;
    o2.y = stage156_y;
    // mov o4.zw, l(0,0,0,0)
    float stage157_z = asfloat(0u);
    float stage157_w = asfloat(0u);
    o4.z = stage157_z;
    o4.w = stage157_w;
    // ftou r0.x, cb0[26].z
    r0.x = asfloat((uint)(cb0[26].z));
    // and r0.x, r0.x, l(31)
    r0.x = asfloat(asuint(r0.x) & asuint(asfloat(31u)));
    // utof r0.x, r0.x
    r0.x = (float)asuint(r0.x);
    // mul o5.w, r0.x, l(0.003922)
    o5.w = r0.x * 0.003922f;
    // mov o5.z, l(0.450000)
    o5.z = 0.45f;

    Shade_Ue3_realpbr_wp_dead_msk_OUTPUT result;
    result.o0 = o0;
    result.o2 = o2;
    result.o3 = o3;
    result.o4 = o4;
    result.o5 = o5;
    result.oMask = oMask;
    return result;
}
