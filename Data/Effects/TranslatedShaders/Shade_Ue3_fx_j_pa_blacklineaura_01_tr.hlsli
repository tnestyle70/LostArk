    // rsq r0.x, r0.x
    r0.x = rsqrt(r0.x);
    // mul r0.xyz, r0.xxxx, v1.xyzx
    float stage42_x = r0.x * v1.x;
    float stage42_y = r0.x * v1.y;
    float stage42_z = r0.x * v1.z;
    r0.x = stage42_x;
    r0.y = stage42_y;
    r0.z = stage42_z;
    // dp3 r0.w, v0.xyzx, v0.xyzx
    r0.w = dot(v0.xyz, v0.xyz);
    // rsq r0.w, r0.w
    r0.w = rsqrt(r0.w);
    // mul r1.xyz, r0.wwww, v0.zxyz
    float stage43_x = r0.w * v0.z;
    float stage43_y = r0.w * v0.x;
    float stage43_z = r0.w * v0.y;
    r1.x = stage43_x;
    r1.y = stage43_y;
    r1.z = stage43_z;
    // mul r0.y, r0.y, r1.y
    r0.y = r0.y * r1.y;
    // mad r0.x, r0.x, r1.z, -r0.y
    r0.x = r0.x * r1.z + -r0.y;
    // mov r1.z, r0.z
    r1.z = r0.z;
    // mul r1.y, r0.x, v1.w
    r1.y = r0.x * v1.w;
    // dp3 r0.x, r1.xyzx, r1.xyzx
    r0.x = dot(r1.xyz, r1.xyz);
    // rsq r0.x, r0.x
    r0.x = rsqrt(r0.x);
    // mul r0.xyz, r0.xxxx, r1.xyzx
    float stage44_x = r0.x * r1.x;
    float stage44_y = r0.x * r1.y;
    float stage44_z = r0.x * r1.z;
    r0.x = stage44_x;
    r0.y = stage44_y;
    r0.z = stage44_z;
    // dp3 r0.w, l(1.000000, 1.000000, 1.000000, 0.000000), |r0.xyzx|
    r0.w = dot(float3(1.0f, 1.0f, 1.0f), abs(r0.xyz));
    // div r0.xy, r0.xyxx, r0.wwww
    float stage45_x = r0.x / r0.w;
    float stage45_y = r0.y / r0.w;
    r0.x = stage45_x;
    r0.y = stage45_y;
    // ge r0.z, l(0.000000), r0.z
    r0.z = asfloat((0.0f >= r0.z) ? 0xffffffffu : 0u);
    // ge r1.xy, r0.xyxx, l(0.000000, 0.000000, 0.000000, 0.000000)
    float stage46_x = asfloat((r0.x >= 0.0f) ? 0xffffffffu : 0u);
    float stage46_y = asfloat((r0.y >= 0.0f) ? 0xffffffffu : 0u);
    r1.x = stage46_x;
    r1.y = stage46_y;
    // movc r1.xy, r1.xyxx, l(1.000000,1.000000,0,0), l(-1.000000,-1.000000,0,0)
    float stage47_x = asuint(r1.x) != 0u ? 1.0f : -1.0f;
    float stage47_y = asuint(r1.y) != 0u ? 1.0f : -1.0f;
    r1.x = stage47_x;
    r1.y = stage47_y;
    // mad r1.xy, -|r0.yxyy|, r1.xyxx, r1.xyxx
    float stage48_x = -(abs(r0.y)) * r1.x + r1.x;
    float stage48_y = -(abs(r0.x)) * r1.y + r1.y;
    r1.x = stage48_x;
    r1.y = stage48_y;
    // movc r0.xy, r0.zzzz, r1.xyxx, r0.xyxx
    float stage49_x = asuint(r0.z) != 0u ? r1.x : r0.x;
    float stage49_y = asuint(r0.z) != 0u ? r1.y : r0.y;
    r0.x = stage49_x;
    r0.y = stage49_y;
    // mad o2.xy, r0.xyxx, l(0.500000, 0.500000, 0.000000, 0.000000), l(0.500000, 0.500000, 0.000000, 0.000000)
    float stage50_x = r0.x * 0.5f + 0.5f;
    float stage50_y = r0.y * 0.5f + 0.5f;
    o2.x = stage50_x;
    o2.y = stage50_y;
    // mov o2.zw, l(0,0,1.000000,0)
    float stage51_z = 1.0f;
    float stage51_w = asfloat(0u);
    o2.z = stage51_z;
    o2.w = stage51_w;
    // mov o3.xyz, cb2[3].xyzx
    float stage52_x = cb2[3].x;
    float stage52_y = cb2[3].y;
    float stage52_z = cb2[3].z;
    o3.x = stage52_x;
    o3.y = stage52_y;
    o3.z = stage52_z;
    // mov o3.w, l(0)
    o3.w = asfloat(0u);
    // mov o4.xyzw, l(0,0,0,0)
    float stage53_x = asfloat(0u);
    float stage53_y = asfloat(0u);
    float stage53_z = asfloat(0u);
    float stage53_w = asfloat(0u);
    o4.x = stage53_x;
    o4.y = stage53_y;
    o4.z = stage53_z;
    o4.w = stage53_w;
    // mov o5.xyzw, l(0,0,0,0)
    float stage54_x = asfloat(0u);
    float stage54_y = asfloat(0u);
    float stage54_z = asfloat(0u);
    float stage54_w = asfloat(0u);
    o5.x = stage54_x;
    o5.y = stage54_y;
    o5.z = stage54_z;
    o5.w = stage54_w;

    Shade_Ue3_fx_j_pa_blacklineaura_01_tr_OUTPUT result;
    result.o0 = o0;
    result.o2 = o2;
    result.o3 = o3;
    result.o4 = o4;
    result.o5 = o5;
    return result;
}
