    // div r0.xy, r0.xyxx, r0.wwww
    float stage51_x = r0.x / r0.w;
    float stage51_y = r0.y / r0.w;
    r0.x = stage51_x;
    r0.y = stage51_y;
    // ge r0.z, l(0.000000), r0.z
    r0.z = asfloat((0.0f >= r0.z) ? 0xffffffffu : 0u);
    // ge r1.xy, r0.xyxx, l(0.000000, 0.000000, 0.000000, 0.000000)
    float stage52_x = asfloat((r0.x >= 0.0f) ? 0xffffffffu : 0u);
    float stage52_y = asfloat((r0.y >= 0.0f) ? 0xffffffffu : 0u);
    r1.x = stage52_x;
    r1.y = stage52_y;
    // movc r1.xy, r1.xyxx, l(1.000000,1.000000,0,0), l(-1.000000,-1.000000,0,0)
    float stage53_x = asuint(r1.x) != 0u ? 1.0f : -1.0f;
    float stage53_y = asuint(r1.y) != 0u ? 1.0f : -1.0f;
    r1.x = stage53_x;
    r1.y = stage53_y;
    // mad r1.xy, -|r0.yxyy|, r1.xyxx, r1.xyxx
    float stage54_x = -(abs(r0.y)) * r1.x + r1.x;
    float stage54_y = -(abs(r0.x)) * r1.y + r1.y;
    r1.x = stage54_x;
    r1.y = stage54_y;
    // movc r0.xy, r0.zzzz, r1.xyxx, r0.xyxx
    float stage55_x = asuint(r0.z) != 0u ? r1.x : r0.x;
    float stage55_y = asuint(r0.z) != 0u ? r1.y : r0.y;
    r0.x = stage55_x;
    r0.y = stage55_y;
    // mad o2.xy, r0.xyxx, l(0.500000, 0.500000, 0.000000, 0.000000), l(0.500000, 0.500000, 0.000000, 0.000000)
    float stage56_x = r0.x * 0.5f + 0.5f;
    float stage56_y = r0.y * 0.5f + 0.5f;
    o2.x = stage56_x;
    o2.y = stage56_y;
    // mov o2.zw, l(0,0,1.000000,0)
    float stage57_z = 1.0f;
    float stage57_w = asfloat(0u);
    o2.z = stage57_z;
    o2.w = stage57_w;
    // mov o3.xyz, cb2[3].xyzx
    float stage58_x = cb2[3].x;
    float stage58_y = cb2[3].y;
    float stage58_z = cb2[3].z;
    o3.x = stage58_x;
    o3.y = stage58_y;
    o3.z = stage58_z;
    // mov o3.w, l(0)
    o3.w = asfloat(0u);
    // mov o4.xyzw, l(0,0,0,0)
    float stage59_x = asfloat(0u);
    float stage59_y = asfloat(0u);
    float stage59_z = asfloat(0u);
    float stage59_w = asfloat(0u);
    o4.x = stage59_x;
    o4.y = stage59_y;
    o4.z = stage59_z;
    o4.w = stage59_w;
    // mov o5.xyzw, l(0,0,0,0)
    float stage60_x = asfloat(0u);
    float stage60_y = asfloat(0u);
    float stage60_z = asfloat(0u);
    float stage60_w = asfloat(0u);
    o5.x = stage60_x;
    o5.y = stage60_y;
    o5.z = stage60_z;
    o5.w = stage60_w;

    Shade_Ue3_fx_k_pa_fluidninja_01_tr_OUTPUT result;
    result.o0 = o0;
    result.o2 = o2;
    result.o3 = o3;
    result.o4 = o4;
    result.o5 = o5;
    return result;
}
