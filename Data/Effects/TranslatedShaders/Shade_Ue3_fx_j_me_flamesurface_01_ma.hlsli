    float stage41_y = r0.y / r0.z;
    r0.x = stage41_x;
    r0.y = stage41_y;
    // ge r1.xy, r0.xyxx, l(0.000000, 0.000000, 0.000000, 0.000000)
    float stage42_x = asfloat((r0.x >= 0.0f) ? 0xffffffffu : 0u);
    float stage42_y = asfloat((r0.y >= 0.0f) ? 0xffffffffu : 0u);
    r1.x = stage42_x;
    r1.y = stage42_y;
    // movc r1.xy, r1.xyxx, l(1.000000,1.000000,0,0), l(-1.000000,-1.000000,0,0)
    float stage43_x = asuint(r1.x) != 0u ? 1.0f : -1.0f;
    float stage43_y = asuint(r1.y) != 0u ? 1.0f : -1.0f;
    r1.x = stage43_x;
    r1.y = stage43_y;
    // mad r1.xy, -|r0.yxyy|, r1.xyxx, r1.xyxx
    float stage44_x = -(abs(r0.y)) * r1.x + r1.x;
    float stage44_y = -(abs(r0.x)) * r1.y + r1.y;
    r1.x = stage44_x;
    r1.y = stage44_y;
    // movc r0.xy, r0.wwww, r1.xyxx, r0.xyxx
    float stage45_x = asuint(r0.w) != 0u ? r1.x : r0.x;
    float stage45_y = asuint(r0.w) != 0u ? r1.y : r0.y;
    r0.x = stage45_x;
    r0.y = stage45_y;
    // mad o2.xy, r0.xyxx, l(0.500000, 0.500000, 0.000000, 0.000000), l(0.500000, 0.500000, 0.000000, 0.000000)
    float stage46_x = r0.x * 0.5f + 0.5f;
    float stage46_y = r0.y * 0.5f + 0.5f;
    o2.x = stage46_x;
    o2.y = stage46_y;
    // mov o2.zw, l(0,0,1.000000,0)
    float stage47_z = 1.0f;
    float stage47_w = asfloat(0u);
    o2.z = stage47_z;
    o2.w = stage47_w;
    // mov o3.xyz, cb2[3].xyzx
    float stage48_x = cb2[3].x;
    float stage48_y = cb2[3].y;
    float stage48_z = cb2[3].z;
    o3.x = stage48_x;
    o3.y = stage48_y;
    o3.z = stage48_z;
    // mov o3.w, l(0)
    o3.w = asfloat(0u);
    // mov o4.xyzw, l(0,0,0,0)
    float stage49_x = asfloat(0u);
    float stage49_y = asfloat(0u);
    float stage49_z = asfloat(0u);
    float stage49_w = asfloat(0u);
    o4.x = stage49_x;
    o4.y = stage49_y;
    o4.z = stage49_z;
    o4.w = stage49_w;
    // mov o5.xyzw, l(0,0,0,0)
    float stage50_x = asfloat(0u);
    float stage50_y = asfloat(0u);
    float stage50_z = asfloat(0u);
    float stage50_w = asfloat(0u);
    o5.x = stage50_x;
    o5.y = stage50_y;
    o5.z = stage50_z;
    o5.w = stage50_w;

    Shade_Ue3_fx_j_me_flamesurface_01_ma_OUTPUT result;
    result.o0 = o0;
    result.o2 = o2;
    result.o3 = o3;
    result.o4 = o4;
    result.o5 = o5;
    result.oMask = oMask;
    return result;
}
