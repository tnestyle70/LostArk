    // dp3 r1.z, r1.xyzx, r0.xyzx
    r1.z = dot(r1.xyz, r0.xyz);
    // dp3 r1.x, r2.xyzx, r0.xyzx
    r1.x = dot(r2.xyz, r0.xyz);
    // mul r2.xyz, r3.xyzx, v1.wwww
    float stage42_x = r3.x * v1.w;
    float stage42_y = r3.y * v1.w;
    float stage42_z = r3.z * v1.w;
    r2.x = stage42_x;
    r2.y = stage42_y;
    r2.z = stage42_z;
    // dp3 r1.y, r2.xyzx, r0.xyzx
    r1.y = dot(r2.xyz, r0.xyz);
    // dp3 r0.x, r1.xyzx, r1.xyzx
    r0.x = dot(r1.xyz, r1.xyz);
    // rsq r0.x, r0.x
    r0.x = rsqrt(r0.x);
    // mul r0.xyz, r0.xxxx, r1.xyzx
    float stage43_x = r0.x * r1.x;
    float stage43_y = r0.x * r1.y;
    float stage43_z = r0.x * r1.z;
    r0.x = stage43_x;
    r0.y = stage43_y;
    r0.z = stage43_z;
    // dp3 r0.w, l(1.000000, 1.000000, 1.000000, 0.000000), |r0.xyzx|
    r0.w = dot(float3(1.0f, 1.0f, 1.0f), abs(r0.xyz));
    // div r0.xy, r0.xyxx, r0.wwww
    float stage44_x = r0.x / r0.w;
    float stage44_y = r0.y / r0.w;
    r0.x = stage44_x;
    r0.y = stage44_y;
    // ge r0.z, l(0.000000), r0.z
    r0.z = asfloat((0.0f >= r0.z) ? 0xffffffffu : 0u);
    // ge r1.xy, r0.xyxx, l(0.000000, 0.000000, 0.000000, 0.000000)
    float stage45_x = asfloat((r0.x >= 0.0f) ? 0xffffffffu : 0u);
    float stage45_y = asfloat((r0.y >= 0.0f) ? 0xffffffffu : 0u);
    r1.x = stage45_x;
    r1.y = stage45_y;
    // movc r1.xy, r1.xyxx, l(1.000000,1.000000,0,0), l(-1.000000,-1.000000,0,0)
    float stage46_x = asuint(r1.x) != 0u ? 1.0f : -1.0f;
    float stage46_y = asuint(r1.y) != 0u ? 1.0f : -1.0f;
    r1.x = stage46_x;
    r1.y = stage46_y;
    // mad r1.xy, -|r0.yxyy|, r1.xyxx, r1.xyxx
    float stage47_x = -(abs(r0.y)) * r1.x + r1.x;
    float stage47_y = -(abs(r0.x)) * r1.y + r1.y;
    r1.x = stage47_x;
    r1.y = stage47_y;
    // movc r0.xy, r0.zzzz, r1.xyxx, r0.xyxx
    float stage48_x = asuint(r0.z) != 0u ? r1.x : r0.x;
    float stage48_y = asuint(r0.z) != 0u ? r1.y : r0.y;
    r0.x = stage48_x;
    r0.y = stage48_y;
    // mad o2.xy, r0.xyxx, l(0.500000, 0.500000, 0.000000, 0.000000), l(0.500000, 0.500000, 0.000000, 0.000000)
    float stage49_x = r0.x * 0.5f + 0.5f;
    float stage49_y = r0.y * 0.5f + 0.5f;
    o2.x = stage49_x;
    o2.y = stage49_y;
    // mov o2.zw, l(0,0,1.000000,0)
    float stage50_z = 1.0f;
    float stage50_w = asfloat(0u);
    o2.z = stage50_z;
    o2.w = stage50_w;
    // mov o3.w, l(0)
    o3.w = asfloat(0u);
    // mov o4.xzw, l(0,0,0,0)
    float stage51_x = asfloat(0u);
    float stage51_z = asfloat(0u);
    float stage51_w = asfloat(0u);
    o4.x = stage51_x;
    o4.z = stage51_z;
    o4.w = stage51_w;
    // mov o5.xyzw, l(0,0,0,0)
    float stage52_x = asfloat(0u);
    float stage52_y = asfloat(0u);
    float stage52_z = asfloat(0u);
    float stage52_w = asfloat(0u);
    o5.x = stage52_x;
    o5.y = stage52_y;
    o5.z = stage52_z;
    o5.w = stage52_w;

    Shade_Ue3_fx_d_me_chain_01_ma_OUTPUT result;
    result.o0 = o0;
    result.o2 = o2;
    result.o3 = o3;
    result.o4 = o4;
    result.o5 = o5;
    result.oMask = oMask;
    return result;
}
