    float stage36_y = asuint(r0.w) != 0u ? r1.y : r0.y;
    r0.x = stage36_x;
    r0.y = stage36_y;
    // mad o2.xy, r0.xyxx, l(0.500000, 0.500000, 0.000000, 0.000000), l(0.500000, 0.500000, 0.000000, 0.000000)
    float stage37_x = r0.x * 0.5f + 0.5f;
    float stage37_y = r0.y * 0.5f + 0.5f;
    o2.x = stage37_x;
    o2.y = stage37_y;
    // mov o2.zw, l(0,0,1.000000,0)
    float stage38_z = 1.0f;
    float stage38_w = asfloat(0u);
    o2.z = stage38_z;
    o2.w = stage38_w;
    // mov o3.xyz, cb2[3].xyzx
    float stage39_x = cb2[3].x;
    float stage39_y = cb2[3].y;
    float stage39_z = cb2[3].z;
    o3.x = stage39_x;
    o3.y = stage39_y;
    o3.z = stage39_z;
    // mov o3.w, l(0)
    o3.w = asfloat(0u);
    // mov o4.xyzw, l(0,0,0,0)
    float stage40_x = asfloat(0u);
    float stage40_y = asfloat(0u);
    float stage40_z = asfloat(0u);
    float stage40_w = asfloat(0u);
    o4.x = stage40_x;
    o4.y = stage40_y;
    o4.z = stage40_z;
    o4.w = stage40_w;
    // mov o5.xyzw, l(0,0,0,0)
    float stage41_x = asfloat(0u);
    float stage41_y = asfloat(0u);
    float stage41_z = asfloat(0u);
    float stage41_w = asfloat(0u);
    o5.x = stage41_x;
    o5.y = stage41_y;
    o5.z = stage41_z;
    o5.w = stage41_w;

    Shade_Ue3_fx_j_me_hologram_01_tr_OUTPUT result;
    result.o0 = o0;
    result.o2 = o2;
    result.o3 = o3;
    result.o4 = o4;
    result.o5 = o5;
    return result;
}
