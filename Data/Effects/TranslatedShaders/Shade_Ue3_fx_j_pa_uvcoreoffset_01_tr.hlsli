    r0.w = dot(float3(1.0f, 1.0f, 1.0f), abs(r0.xyz));
    // div r0.xy, r0.xyxx, r0.wwww
    float stage39_x = r0.x / r0.w;
    float stage39_y = r0.y / r0.w;
    r0.x = stage39_x;
    r0.y = stage39_y;
    // ge r0.z, l(0.000000), r0.z
    r0.z = asfloat((0.0f >= r0.z) ? 0xffffffffu : 0u);
    // ge r1.xy, r0.xyxx, l(0.000000, 0.000000, 0.000000, 0.000000)
    float stage40_x = asfloat((r0.x >= 0.0f) ? 0xffffffffu : 0u);
    float stage40_y = asfloat((r0.y >= 0.0f) ? 0xffffffffu : 0u);
    r1.x = stage40_x;
    r1.y = stage40_y;
    // movc r1.xy, r1.xyxx, l(1.000000,1.000000,0,0), l(-1.000000,-1.000000,0,0)
    float stage41_x = asuint(r1.x) != 0u ? 1.0f : -1.0f;
    float stage41_y = asuint(r1.y) != 0u ? 1.0f : -1.0f;
    r1.x = stage41_x;
    r1.y = stage41_y;
    // mad r1.xy, -|r0.yxyy|, r1.xyxx, r1.xyxx
    float stage42_x = -(abs(r0.y)) * r1.x + r1.x;
    float stage42_y = -(abs(r0.x)) * r1.y + r1.y;
    r1.x = stage42_x;
    r1.y = stage42_y;
    // movc r0.xy, r0.zzzz, r1.xyxx, r0.xyxx
    float stage43_x = asuint(r0.z) != 0u ? r1.x : r0.x;
    float stage43_y = asuint(r0.z) != 0u ? r1.y : r0.y;
    r0.x = stage43_x;
    r0.y = stage43_y;
    // mad o2.xy, r0.xyxx, l(0.500000, 0.500000, 0.000000, 0.000000), l(0.500000, 0.500000, 0.000000, 0.000000)
    float stage44_x = r0.x * 0.5f + 0.5f;
    float stage44_y = r0.y * 0.5f + 0.5f;
    o2.x = stage44_x;
    o2.y = stage44_y;
    // mov o2.zw, l(0,0,1.000000,0)
    float stage45_z = 1.0f;
    float stage45_w = asfloat(0u);
    o2.z = stage45_z;
    o2.w = stage45_w;
    // mov o3.xyz, cb2[3].xyzx
    float stage46_x = cb2[3].x;
    float stage46_y = cb2[3].y;
    float stage46_z = cb2[3].z;
    o3.x = stage46_x;
    o3.y = stage46_y;
    o3.z = stage46_z;
    // mov o3.w, l(0)
    o3.w = asfloat(0u);
    // mov o4.xyzw, l(0,0,0,0)
    float stage47_x = asfloat(0u);
    float stage47_y = asfloat(0u);
    float stage47_z = asfloat(0u);
    float stage47_w = asfloat(0u);
    o4.x = stage47_x;
    o4.y = stage47_y;
    o4.z = stage47_z;
    o4.w = stage47_w;
    // mov o5.xyzw, l(0,0,0,0)
    float stage48_x = asfloat(0u);
    float stage48_y = asfloat(0u);
    float stage48_z = asfloat(0u);
    float stage48_w = asfloat(0u);
    o5.x = stage48_x;
    o5.y = stage48_y;
    o5.z = stage48_z;
    o5.w = stage48_w;

    Shade_Ue3_fx_j_pa_uvcoreoffset_01_tr_OUTPUT result;
    result.o0 = o0;
    result.o2 = o2;
    result.o3 = o3;
    result.o4 = o4;
    result.o5 = o5;
    return result;
}
