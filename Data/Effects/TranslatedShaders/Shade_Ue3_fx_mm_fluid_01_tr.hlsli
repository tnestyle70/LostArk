    float stage48_x = asuint(r0.z) != 0u ? r1.x : r0.x;
    float stage48_y = asuint(r0.z) != 0u ? r1.y : r0.y;
    r0.x = stage48_x;
    r0.y = stage48_y;
    // mad o2.xy, r0.xyxx, l(0.500000, 0.500000, 0.000000, 0.000000), l(0.500000, 0.500000, 0.000000, 0.000000)
    float stage49_x = r0.x * 0.5f + 0.5f;
    float stage49_y = r0.y * 0.5f + 0.5f;
    o2.x = stage49_x;
    o2.y = stage49_y;
    // mov o2.zw, l(0,0,1.000000,0)
    float stage50_z = 1.0f;
    float stage50_w = asfloat(0u);
    o2.z = stage50_z;
    o2.w = stage50_w;
    // mov o3.xyz, cb2[3].xyzx
    float stage51_x = cb2[3].x;
    float stage51_y = cb2[3].y;
    float stage51_z = cb2[3].z;
    o3.x = stage51_x;
    o3.y = stage51_y;
    o3.z = stage51_z;
    // mov o3.w, l(0)
    o3.w = asfloat(0u);
    // mov o4.xyzw, l(0,0,0,0)
    float stage52_x = asfloat(0u);
    float stage52_y = asfloat(0u);
    float stage52_z = asfloat(0u);
    float stage52_w = asfloat(0u);
    o4.x = stage52_x;
    o4.y = stage52_y;
    o4.z = stage52_z;
    o4.w = stage52_w;
    // mov o5.xyzw, l(0,0,0,0)
    float stage53_x = asfloat(0u);
    float stage53_y = asfloat(0u);
    float stage53_z = asfloat(0u);
    float stage53_w = asfloat(0u);
    o5.x = stage53_x;
    o5.y = stage53_y;
    o5.z = stage53_z;
    o5.w = stage53_w;

    Shade_Ue3_fx_mm_fluid_01_tr_OUTPUT result;
    result.o0 = o0;
    result.o2 = o2;
    result.o3 = o3;
    result.o4 = o4;
    result.o5 = o5;
    return result;
}
