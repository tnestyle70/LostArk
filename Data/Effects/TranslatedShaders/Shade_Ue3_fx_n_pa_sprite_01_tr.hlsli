    // dp2 r5.x, cb0[7].xyxx, r3.zwzz
    r5.x = dot(cb0[7].xy, r3.zw);
    // dp2 r5.y, cb0[8].xyxx, r3.zwzz
    r5.y = dot(cb0[8].xy, r3.zw);
    // add r1.xw, r5.xxxy, l(0.500000, 0.000000, 0.000000, 0.500000)
    float stage34_x = r5.x + 0.5f;
    float stage34_w = r5.y + 0.5f;
    r1.x = stage34_x;
    r1.w = stage34_w;
    // mul r2.z, v4.w, cb0[19].z
    r2.z = v4.w * cb0[19].z;
    // mad r1.xw, r2.zzzz, r2.xxxy, r1.xxxw
    float stage35_x = r2.z * r2.x + r1.x;
    float stage35_w = r2.z * r2.y + r1.w;
    r1.x = stage35_x;
    r1.w = stage35_w;
    // mul r2.xy, r2.xyxx, r2.zzzz
    float stage36_x = r2.x * r2.z;
    float stage36_y = r2.y * r2.z;
    r2.x = stage36_x;
    r2.y = stage36_y;
    // mad r2.xy, r3.xyxx, l(2.000000, 4.000000, 0.000000, 0.000000), r2.xyxx
    float stage37_x = r3.x * 2.0f + r2.x;
    float stage37_y = r3.y * 4.0f + r2.y;
    r2.x = stage37_x;
    r2.y = stage37_y;
    // sample_b_indexable(texture2d)(float,float,float,float) r2.x, r2.xyxx, t2.xyzw, s8, l(0.000000)
    float4 fetch38 = t2.SampleBias(s8, r2.xy, 0.0f);
    r2.x = fetch38.x;
    // sample_l_indexable(texture2d)(float,float,float,float) r1.x, r1.xwxx, t1.xyzw, s5, l(0.000000)
    float4 fetch39 = t1.SampleLevel(s5, r1.xw, 0.0f);
    r1.x = fetch39.x;
    // mul r1.z, r1.x, r1.z
    r1.z = r1.x * r1.z;
    // mul r3.xyz, v4.zzzz, cb0[11].xyzx
    float stage40_x = v4.z * cb0[11].x;
    float stage40_y = v4.z * cb0[11].y;
    float stage40_z = v4.z * cb0[11].z;
    r3.x = stage40_x;
    r3.y = stage40_y;
    r3.z = stage40_z;
    // mul r3.xyz, r0.wwww, r3.xyzx
    float stage41_x = r0.w * r3.x;
    float stage41_y = r0.w * r3.y;
    float stage41_z = r0.w * r3.z;
    r3.x = stage41_x;
    r3.y = stage41_y;
    r3.z = stage41_z;
    // mul r3.xyz, r1.zzzz, r3.xyzx
    float stage42_x = r1.z * r3.x;
    float stage42_y = r1.z * r3.y;
    float stage42_z = r1.z * r3.z;
    r3.x = stage42_x;
    r3.y = stage42_y;
    r3.z = stage42_z;
    // mad r3.xyz, r1.xxxx, r4.xyzx, r3.xyzx
    float stage43_x = r1.x * r4.x + r3.x;
    float stage43_y = r1.x * r4.y + r3.y;
    float stage43_z = r1.x * r4.z + r3.z;
    r3.x = stage43_x;
    r3.y = stage43_y;
    r3.z = stage43_z;
    // mul r0.w, r1.x, r1.y
    r0.w = r1.x * r1.y;
    // mad r0.xyz, r1.zzzz, r0.xyzx, r3.xyzx
    float stage44_x = r1.z * r0.x + r3.x;
    float stage44_y = r1.z * r0.y + r3.y;
    float stage44_z = r1.z * r0.z + r3.z;
    r0.x = stage44_x;
    r0.y = stage44_y;
    r0.z = stage44_z;
    // mad r0.xyz, r0.xyzx, cb0[12].xyzx, cb0[1].xyzx
    float stage45_x = r0.x * cb0[12].x + cb0[1].x;
    float stage45_y = r0.y * cb0[12].y + cb0[1].y;
    float stage45_z = r0.z * cb0[12].z + cb0[1].z;
    r0.x = stage45_x;
    r0.y = stage45_y;
    r0.z = stage45_z;
    // mad o0.xyz, r0.xyzx, v5.wwww, v5.xyzx
    float stage46_x = r0.x * v5.w + v5.x;
    float stage46_y = r0.y * v5.w + v5.y;
    float stage46_z = r0.z * v5.w + v5.z;
    o0.x = stage46_x;
    o0.y = stage46_y;
    o0.z = stage46_z;
    // mov_sat r0.x, v4.y
    r0.x = saturate(v4.y);
    // add r0.x, -r0.x, l(1.000000)
    r0.x = -r0.x + 1.0f;
    // mul r0.x, r2.x, r0.x
    r0.x = r2.x * r0.x;
    // mad_sat r0.x, -r0.x, l(100.000000), l(1.000000)
    r0.x = saturate(-r0.x * 100.0f + 1.0f);
    // mul r0.x, r0.x, r0.w
    r0.x = r0.x * r0.w;
    // mul r0.x, r0.x, v3.w
    r0.x = r0.x * v3.w;
    // mul r0.x, r0.x, r0.x
    r0.x = r0.x * r0.x;
    // mul r0.x, r0.x, r2.w
    r0.x = r0.x * r2.w;
    // mul o0.w, r0.x, cb0[0].x
    o0.w = r0.x * cb0[0].x;
    // dp3 r0.x, v1.xyzx, v1.xyzx
    r0.x = dot(v1.xyz, v1.xyz);
    // rsq r0.x, r0.x
    r0.x = rsqrt(r0.x);
    // mul r0.xyz, r0.xxxx, v1.xyzx
    float stage47_x = r0.x * v1.x;
    float stage47_y = r0.x * v1.y;
    float stage47_z = r0.x * v1.z;
    r0.x = stage47_x;
    r0.y = stage47_y;
    r0.z = stage47_z;
    // dp3 r0.w, v0.xyzx, v0.xyzx
    r0.w = dot(v0.xyz, v0.xyz);
    // rsq r0.w, r0.w
    r0.w = rsqrt(r0.w);
    // mul r1.xyz, r0.wwww, v0.zxyz
    float stage48_x = r0.w * v0.z;
    float stage48_y = r0.w * v0.x;
    float stage48_z = r0.w * v0.y;
    r1.x = stage48_x;
    r1.y = stage48_y;
    r1.z = stage48_z;
    // mul r0.y, r0.y, r1.y
    r0.y = r0.y * r1.y;
    // mad r0.x, r0.x, r1.z, -r0.y
    r0.x = r0.x * r1.z + -r0.y;
    // mov r1.z, r0.z
    r1.z = r0.z;
    // mul r1.y, r0.x, v1.w
    r1.y = r0.x * v1.w;
    // dp3 r0.x, r1.xyzx, r1.xyzx
    r0.x = dot(r1.xyz, r1.xyz);
    // rsq r0.x, r0.x
    r0.x = rsqrt(r0.x);
    // mul r0.xyz, r0.xxxx, r1.xyzx
    float stage49_x = r0.x * r1.x;
    float stage49_y = r0.x * r1.y;
    float stage49_z = r0.x * r1.z;
    r0.x = stage49_x;
    r0.y = stage49_y;
    r0.z = stage49_z;
    // dp3 r0.w, l(1.000000, 1.000000, 1.000000, 0.000000), |r0.xyzx|
    r0.w = dot(float3(1.0f, 1.0f, 1.0f), abs(r0.xyz));
    // div r0.xy, r0.xyxx, r0.wwww
    float stage50_x = r0.x / r0.w;
    float stage50_y = r0.y / r0.w;
    r0.x = stage50_x;
    r0.y = stage50_y;
    // ge r0.z, l(0.000000), r0.z
    r0.z = asfloat((0.0f >= r0.z) ? 0xffffffffu : 0u);
    // ge r1.xy, r0.xyxx, l(0.000000, 0.000000, 0.000000, 0.000000)
    float stage51_x = asfloat((r0.x >= 0.0f) ? 0xffffffffu : 0u);
    float stage51_y = asfloat((r0.y >= 0.0f) ? 0xffffffffu : 0u);
    r1.x = stage51_x;
    r1.y = stage51_y;
    // movc r1.xy, r1.xyxx, l(1.000000,1.000000,0,0), l(-1.000000,-1.000000,0,0)
    float stage52_x = asuint(r1.x) != 0u ? 1.0f : -1.0f;
    float stage52_y = asuint(r1.y) != 0u ? 1.0f : -1.0f;
    r1.x = stage52_x;
    r1.y = stage52_y;
    // mad r1.xy, -|r0.yxyy|, r1.xyxx, r1.xyxx
    float stage53_x = -(abs(r0.y)) * r1.x + r1.x;
    float stage53_y = -(abs(r0.x)) * r1.y + r1.y;
    r1.x = stage53_x;
    r1.y = stage53_y;
    // movc r0.xy, r0.zzzz, r1.xyxx, r0.xyxx
    float stage54_x = asuint(r0.z) != 0u ? r1.x : r0.x;
    float stage54_y = asuint(r0.z) != 0u ? r1.y : r0.y;
    r0.x = stage54_x;
    r0.y = stage54_y;
    // mad o2.xy, r0.xyxx, l(0.500000, 0.500000, 0.000000, 0.000000), l(0.500000, 0.500000, 0.000000, 0.000000)
    float stage55_x = r0.x * 0.5f + 0.5f;
    float stage55_y = r0.y * 0.5f + 0.5f;
    o2.x = stage55_x;
    o2.y = stage55_y;
    // mov o2.zw, l(0,0,1.000000,0)
    float stage56_z = 1.0f;
    float stage56_w = asfloat(0u);
    o2.z = stage56_z;
    o2.w = stage56_w;
    // mov o3.xyz, cb2[3].xyzx
    float stage57_x = cb2[3].x;
    float stage57_y = cb2[3].y;
    float stage57_z = cb2[3].z;
    o3.x = stage57_x;
    o3.y = stage57_y;
    o3.z = stage57_z;
    // mov o3.w, l(0)
    o3.w = asfloat(0u);
    // mov o4.xyzw, l(0,0,0,0)
    float stage58_x = asfloat(0u);
    float stage58_y = asfloat(0u);
    float stage58_z = asfloat(0u);
    float stage58_w = asfloat(0u);
    o4.x = stage58_x;
    o4.y = stage58_y;
    o4.z = stage58_z;
    o4.w = stage58_w;
    // mov o5.xyzw, l(0,0,0,0)
    float stage59_x = asfloat(0u);
    float stage59_y = asfloat(0u);
    float stage59_z = asfloat(0u);
    float stage59_w = asfloat(0u);
    o5.x = stage59_x;
    o5.y = stage59_y;
    o5.z = stage59_z;
    o5.w = stage59_w;

    Shade_Ue3_fx_n_pa_sprite_01_tr_OUTPUT result;
    result.o0 = o0;
    result.o2 = o2;
    result.o3 = o3;
    result.o4 = o4;
    result.o5 = o5;
    return result;
}
