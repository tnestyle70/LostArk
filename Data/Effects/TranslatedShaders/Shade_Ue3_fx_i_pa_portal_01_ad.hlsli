    r0.x = r0.x * cb0[8].z;
    // movc r0.x, r0.y, l(0), r0.x
    r0.x = asuint(r0.y) != 0u ? asfloat(0u) : r0.x;
    // mad r0.xyz, r0.xxxx, r2.xyzx, r3.xyzx
    float stage45_x = r0.x * r2.x + r3.x;
    float stage45_y = r0.x * r2.y + r3.y;
    float stage45_z = r0.x * r2.z + r3.z;
    r0.x = stage45_x;
    r0.y = stage45_y;
    r0.z = stage45_z;
    // mad r0.xyz, r0.xyzx, v3.xyzx, cb0[1].xyzx
    float stage46_x = r0.x * v3.x + cb0[1].x;
    float stage46_y = r0.y * v3.y + cb0[1].y;
    float stage46_z = r0.z * v3.z + cb0[1].z;
    r0.x = stage46_x;
    r0.y = stage46_y;
    r0.z = stage46_z;
    // mul r0.xyz, r0.xyzx, v5.wwww
    float stage47_x = r0.x * v5.w;
    float stage47_y = r0.y * v5.w;
    float stage47_z = r0.z * v5.w;
    r0.x = stage47_x;
    r0.y = stage47_y;
    r0.z = stage47_z;
    // mad r1.xy, v2.xyxx, l(2.000000, 2.000000, 0.000000, 0.000000), l(-1.000000, -1.000000, 0.000000, 0.000000)
    float stage48_x = v2.x * 2.0f + -1.0f;
    float stage48_y = v2.y * 2.0f + -1.0f;
    r1.x = stage48_x;
    r1.y = stage48_y;
    // dp2 r0.w, r1.xyxx, r1.xyxx
    r0.w = dot(r1.xy, r1.xy);
    // min r0.w, r0.w, l(1.000000)
    r0.w = min(r0.w, 1.0f);
    // log r1.x, r0.w
    r1.x = log2(r0.w);
    // mul r1.x, r1.x, cb0[13].x
    r1.x = r1.x * cb0[13].x;
    // exp r1.x, r1.x
    r1.x = exp2(r1.x);
    // mul r1.x, r1.x, cb0[13].y
    r1.x = r1.x * cb0[13].y;
    // lt r1.y, r0.w, l(0.000001)
    r1.y = asfloat((r0.w < 1e-06f) ? 0xffffffffu : 0u);
    // add r0.w, -r0.w, l(1.000000)
    r0.w = -r0.w + 1.0f;
    // movc r1.x, r1.y, l(0), r1.x
    r1.x = asuint(r1.y) != 0u ? asfloat(0u) : r1.x;
    // log r1.y, r0.w
    r1.y = log2(r0.w);
    // lt r0.w, r0.w, l(0.000001)
    r0.w = asfloat((r0.w < 1e-06f) ? 0xffffffffu : 0u);
    // mul r1.y, r1.y, cb0[12].w
    r1.y = r1.y * cb0[12].w;
    // exp r1.y, r1.y
    r1.y = exp2(r1.y);
    // movc r0.w, r0.w, l(0), r1.y
    r0.w = asuint(r0.w) != 0u ? asfloat(0u) : r1.y;
    // mul_sat r0.w, r1.x, r0.w
    r0.w = saturate(r1.x * r0.w);
    // mul r0.w, r0.w, cb0[13].z
    r0.w = r0.w * cb0[13].z;
    // mul r0.w, r0.w, v3.w
    r0.w = r0.w * v3.w;
    // mul r0.w, r0.w, cb0[0].x
    r0.w = r0.w * cb0[0].x;
    // mul o0.xyz, r0.wwww, r0.xyzx
    float stage49_x = r0.w * r0.x;
    float stage49_y = r0.w * r0.y;
    float stage49_z = r0.w * r0.z;
    o0.x = stage49_x;
    o0.y = stage49_y;
    o0.z = stage49_z;
    // mov o0.w, l(0)
    o0.w = asfloat(0u);

    Shade_Ue3_fx_i_pa_portal_01_ad_OUTPUT result;
    result.o0 = o0;
    return result;
}
