    // add r0.xyw, r0.xyxw, cb0[1].xyxz
    float stage38_x = r0.x + cb0[1].x;
    float stage38_y = r0.y + cb0[1].y;
    float stage38_w = r0.w + cb0[1].z;
    r0.x = stage38_x;
    r0.y = stage38_y;
    r0.w = stage38_w;
    // mad o0.xyz, r0.xywx, v5.wwww, v5.xyzx
    float stage39_x = r0.x * v5.w + v5.x;
    float stage39_y = r0.y * v5.w + v5.y;
    float stage39_z = r0.w * v5.w + v5.z;
    o0.x = stage39_x;
    o0.y = stage39_y;
    o0.z = stage39_z;
    // log r0.x, r0.z
    r0.x = log2(r0.z);
    // lt r0.y, r0.z, l(0.000001)
    r0.y = asfloat((r0.z < 1e-06f) ? 0xffffffffu : 0u);
    // mul r0.x, r0.x, cb0[16].z
    r0.x = r0.x * cb0[16].z;
    // exp r0.x, r0.x
    r0.x = exp2(r0.x);
    // min r0.x, r0.x, l(1.000000)
    r0.x = min(r0.x, 1.0f);
    // movc r0.x, r0.y, l(0), r0.x
    r0.x = asuint(r0.y) != 0u ? asfloat(0u) : r0.x;
    // mov_sat r0.y, v3.z
    r0.y = saturate(v3.z);
    // add r0.y, -r0.y, l(1.000000)
    r0.y = -r0.y + 1.0f;
    // add r0.x, -r0.y, r0.x
    r0.x = -r0.y + r0.x;
    // max r0.x, r0.x, l(0.000000)
    r0.x = max(r0.x, 0.0f);
    // mul_sat r0.x, r0.x, v3.w
    r0.x = saturate(r0.x * v3.w);
    // mul o0.w, r0.x, cb0[0].w
    o0.w = r0.x * cb0[0].w;
    // dp3 r0.x, v1.xyzx, v1.xyzx
    r0.x = dot(v1.xyz, v1.xyz);
    // rsq r0.x, r0.x
    r0.x = rsqrt(r0.x);
    // mul r0.xyz, r0.xxxx, v1.xyzx
    float stage40_x = r0.x * v1.x;
    float stage40_y = r0.x * v1.y;
    float stage40_z = r0.x * v1.z;
    r0.x = stage40_x;
    r0.y = stage40_y;
    r0.z = stage40_z;
    // dp3 r0.w, v0.xyzx, v0.xyzx
    r0.w = dot(v0.xyz, v0.xyz);
    // rsq r0.w, r0.w
    r0.w = rsqrt(r0.w);
    // mul r1.xyz, r0.wwww, v0.zxyz
    float stage41_x = r0.w * v0.z;
    float stage41_y = r0.w * v0.x;
    float stage41_z = r0.w * v0.y;
    r1.x = stage41_x;
    r1.y = stage41_y;
    r1.z = stage41_z;
    // mul r0.y, r0.y, r1.y
    r0.y = r0.y * r1.y;
    // mad r0.x, r0.x, r1.z, -r0.y
    r0.x = r0.x * r1.z + -r0.y;
    // mov r1.z, r0.z
    r1.z = r0.z;
    // mul r1.y, r0.x, v1.w
    r1.y = r0.x * v1.w;
    // dp3 r0.x, r1.xyzx, r1.xyzx
    r0.x = dot(r1.xyz, r1.xyz);
    // rsq r0.x, r0.x
    r0.x = rsqrt(r0.x);
    // mul r0.xyz, r0.xxxx, r1.xyzx
    float stage42_x = r0.x * r1.x;
    float stage42_y = r0.x * r1.y;
    float stage42_z = r0.x * r1.z;
    r0.x = stage42_x;
    r0.y = stage42_y;
    r0.z = stage42_z;
    // dp3 r0.w, l(1.000000, 1.000000, 1.000000, 0.000000), |r0.xyzx|
    r0.w = dot(float3(1.0f, 1.0f, 1.0f), abs(r0.xyz));
    // div r0.xy, r0.xyxx, r0.wwww
    float stage43_x = r0.x / r0.w;
    float stage43_y = r0.y / r0.w;
    r0.x = stage43_x;
    r0.y = stage43_y;
    // ge r0.z, l(0.000000), r0.z
    r0.z = asfloat((0.0f >= r0.z) ? 0xffffffffu : 0u);
    // ge r1.xy, r0.xyxx, l(0.000000, 0.000000, 0.000000, 0.000000)
    float stage44_x = asfloat((r0.x >= 0.0f) ? 0xffffffffu : 0u);
    float stage44_y = asfloat((r0.y >= 0.0f) ? 0xffffffffu : 0u);
    r1.x = stage44_x;
    r1.y = stage44_y;
    // movc r1.xy, r1.xyxx, l(1.000000,1.000000,0,0), l(-1.000000,-1.000000,0,0)
    float stage45_x = asuint(r1.x) != 0u ? 1.0f : -1.0f;
    float stage45_y = asuint(r1.y) != 0u ? 1.0f : -1.0f;
    r1.x = stage45_x;
    r1.y = stage45_y;
    // mad r1.xy, -|r0.yxyy|, r1.xyxx, r1.xyxx
    float stage46_x = -(abs(r0.y)) * r1.x + r1.x;
    float stage46_y = -(abs(r0.x)) * r1.y + r1.y;
    r1.x = stage46_x;
    r1.y = stage46_y;
    // movc r0.xy, r0.zzzz, r1.xyxx, r0.xyxx
    float stage47_x = asuint(r0.z) != 0u ? r1.x : r0.x;
    float stage47_y = asuint(r0.z) != 0u ? r1.y : r0.y;
    r0.x = stage47_x;
    r0.y = stage47_y;
    // mad o2.xy, r0.xyxx, l(0.500000, 0.500000, 0.000000, 0.000000), l(0.500000, 0.500000, 0.000000, 0.000000)
    float stage48_x = r0.x * 0.5f + 0.5f;
    float stage48_y = r0.y * 0.5f + 0.5f;
    o2.x = stage48_x;
    o2.y = stage48_y;
    // mov o2.zw, l(0,0,1.000000,0)
    float stage49_z = 1.0f;
    float stage49_w = asfloat(0u);
    o2.z = stage49_z;
    o2.w = stage49_w;
    // mov o3.xyz, cb2[3].xyzx
    float stage50_x = cb2[3].x;
    float stage50_y = cb2[3].y;
    float stage50_z = cb2[3].z;
    o3.x = stage50_x;
    o3.y = stage50_y;
    o3.z = stage50_z;
    // mov o3.w, l(0)
    o3.w = asfloat(0u);
    // mov o4.xyzw, l(0,0,0,0)
    float stage51_x = asfloat(0u);
    float stage51_y = asfloat(0u);
    float stage51_z = asfloat(0u);
    float stage51_w = asfloat(0u);
    o4.x = stage51_x;
    o4.y = stage51_y;
    o4.z = stage51_z;
    o4.w = stage51_w;
    // mov o5.xyzw, l(0,0,0,0)
    float stage52_x = asfloat(0u);
    float stage52_y = asfloat(0u);
    float stage52_z = asfloat(0u);
    float stage52_w = asfloat(0u);
    o5.x = stage52_x;
    o5.y = stage52_y;
    o5.z = stage52_z;
    o5.w = stage52_w;

    Shade_Ue3_fx_m_flowergarden_ringmaster_01_tr_OUTPUT result;
    result.o0 = o0;
    result.o2 = o2;
    result.o3 = o3;
    result.o4 = o4;
    result.o5 = o5;
    return result;
}
