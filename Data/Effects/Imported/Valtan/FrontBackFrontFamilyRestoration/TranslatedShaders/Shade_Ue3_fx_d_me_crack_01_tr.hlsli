    o4.y = dot(r1.xyz, float3(0.3f, 0.59f, 0.11f));
    // mad r0.xyz, r2.xyzx, cb0[16].xyzx, r0.xyzx
    float stage49_x = r2.x * cb0[16].x + r0.x;
    float stage49_y = r2.y * cb0[16].y + r0.y;
    float stage49_z = r2.z * cb0[16].z + r0.z;
    r0.x = stage49_x;
    r0.y = stage49_y;
    r0.z = stage49_z;
    // mov o3.xyz, r2.xyzx
    float stage50_x = r2.x;
    float stage50_y = r2.y;
    float stage50_z = r2.z;
    o3.x = stage50_x;
    o3.y = stage50_y;
    o3.z = stage50_z;
    // mad o0.xyz, r0.xyzx, v5.wwww, v5.xyzx
    float stage51_x = r0.x * v5.w + v5.x;
    float stage51_y = r0.y * v5.w + v5.y;
    float stage51_z = r0.z * v5.w + v5.z;
    o0.x = stage51_x;
    o0.y = stage51_y;
    o0.z = stage51_z;
    // dp3 r0.x, v1.xyzx, v1.xyzx
    r0.x = dot(v1.xyz, v1.xyz);
    // rsq r0.x, r0.x
    r0.x = rsqrt(r0.x);
    // mul r0.xyz, r0.xxxx, v1.xyzx
    float stage52_x = r0.x * v1.x;
    float stage52_y = r0.x * v1.y;
    float stage52_z = r0.x * v1.z;
    r0.x = stage52_x;
    r0.y = stage52_y;
    r0.z = stage52_z;
    // dp3 r0.w, v0.xyzx, v0.xyzx
    r0.w = dot(v0.xyz, v0.xyz);
    // rsq r0.w, r0.w
    r0.w = rsqrt(r0.w);
    // mul r1.xyz, r0.wwww, v0.zxyz
    float stage53_x = r0.w * v0.z;
    float stage53_y = r0.w * v0.x;
    float stage53_z = r0.w * v0.y;
    r1.x = stage53_x;
    r1.y = stage53_y;
    r1.z = stage53_z;
    // mul r0.y, r0.y, r1.y
    r0.y = r0.y * r1.y;
    // mad r0.x, r0.x, r1.z, -r0.y
    r0.x = r0.x * r1.z + -r0.y;
    // mov r1.z, r0.z
    r1.z = r0.z;
    // mul r1.y, r0.x, v1.w
    r1.y = r0.x * v1.w;
    // dp3 r0.x, r1.xyzx, r1.xyzx
    r0.x = dot(r1.xyz, r1.xyz);
    // rsq r0.x, r0.x
    r0.x = rsqrt(r0.x);
    // mul r0.xyz, r0.xxxx, r1.xyzx
    float stage54_x = r0.x * r1.x;
    float stage54_y = r0.x * r1.y;
    float stage54_z = r0.x * r1.z;
    r0.x = stage54_x;
    r0.y = stage54_y;
    r0.z = stage54_z;
    // dp3 r0.w, l(1.000000, 1.000000, 1.000000, 0.000000), |r0.xyzx|
    r0.w = dot(float3(1.0f, 1.0f, 1.0f), abs(r0.xyz));
    // div r0.xy, r0.xyxx, r0.wwww
    float stage55_x = r0.x / r0.w;
    float stage55_y = r0.y / r0.w;
    r0.x = stage55_x;
    r0.y = stage55_y;
    // ge r0.z, l(0.000000), r0.z
    r0.z = asfloat((0.0f >= r0.z) ? 0xffffffffu : 0u);
    // ge r1.xy, r0.xyxx, l(0.000000, 0.000000, 0.000000, 0.000000)
    float stage56_x = asfloat((r0.x >= 0.0f) ? 0xffffffffu : 0u);
    float stage56_y = asfloat((r0.y >= 0.0f) ? 0xffffffffu : 0u);
    r1.x = stage56_x;
    r1.y = stage56_y;
    // movc r1.xy, r1.xyxx, l(1.000000,1.000000,0,0), l(-1.000000,-1.000000,0,0)
    float stage57_x = asuint(r1.x) != 0u ? 1.0f : -1.0f;
    float stage57_y = asuint(r1.y) != 0u ? 1.0f : -1.0f;
    r1.x = stage57_x;
    r1.y = stage57_y;
    // mad r1.xy, -|r0.yxyy|, r1.xyxx, r1.xyxx
    float stage58_x = -(abs(r0.y)) * r1.x + r1.x;
    float stage58_y = -(abs(r0.x)) * r1.y + r1.y;
    r1.x = stage58_x;
    r1.y = stage58_y;
    // movc r0.xy, r0.zzzz, r1.xyxx, r0.xyxx
    float stage59_x = asuint(r0.z) != 0u ? r1.x : r0.x;
    float stage59_y = asuint(r0.z) != 0u ? r1.y : r0.y;
    r0.x = stage59_x;
    r0.y = stage59_y;
    // mad o2.xy, r0.xyxx, l(0.500000, 0.500000, 0.000000, 0.000000), l(0.500000, 0.500000, 0.000000, 0.000000)
    float stage60_x = r0.x * 0.5f + 0.5f;
    float stage60_y = r0.y * 0.5f + 0.5f;
    o2.x = stage60_x;
    o2.y = stage60_y;
    // mov o2.zw, l(0,0,1.000000,0)
    float stage61_z = 1.0f;
    float stage61_w = asfloat(0u);
    o2.z = stage61_z;
    o2.w = stage61_w;
    // mov o3.w, l(0)
    o3.w = asfloat(0u);
    // mov o4.xzw, l(0,0,0,0)
    float stage62_x = asfloat(0u);
    float stage62_z = asfloat(0u);
    float stage62_w = asfloat(0u);
    o4.x = stage62_x;
    o4.z = stage62_z;
    o4.w = stage62_w;
    // mov o5.xyzw, l(0,0,0,0)
    float stage63_x = asfloat(0u);
    float stage63_y = asfloat(0u);
    float stage63_z = asfloat(0u);
    float stage63_w = asfloat(0u);
    o5.x = stage63_x;
    o5.y = stage63_y;
    o5.z = stage63_z;
    o5.w = stage63_w;

    Shade_Ue3_fx_d_me_crack_01_tr_OUTPUT result;
    result.o0 = o0;
    result.o2 = o2;
    result.o3 = o3;
    result.o4 = o4;
    result.o5 = o5;
    return result;
}
