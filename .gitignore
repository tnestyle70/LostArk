# Visual Studio user state
.vs/
**/.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.VC.db
*.VC.VC.opendb

# Build and intermediate directories
/x64/
/x86/
**/x64/
**/x86/
**/[Dd]ebug/
**/[Rr]elease/
**/[Oo]bj/
**/ipch/

# Compiler, linker, and debugger outputs
*.obj
*.iobj
*.ipdb
*.pch
*.pdb
*.ilk
*.idb
*.exp
*.exe
*.dll
*.lib
*.tlog
*.lastbuildstate
*.recipe
*.FileListAbsolute.txt
*.CppClean.log
*.log

# Generated shader binaries
*.cso

# EngineSDK is regenerated by UpdateLib.bat.
/EngineSDK/

# Local extraction, cook, and generated workspaces
/_work/
/out/

# Cooked runtime resources are distributed through the shared Drive pack.
*.wmesh
*.wmat
*.wskel
*.wanim

# Engine output directory: preserve shader source, ignore built binaries.
/Engine/Bin/*
!/Engine/Bin/ShaderFiles/
!/Engine/Bin/ShaderFiles/**

# Client runtime directory: Resources are shared through Drive, not Git or Git LFS.
/Client/Bin/*
/Client/Bin/Resources/
!/Client/Bin/DataFiles/
!/Client/Bin/DataFiles/**
!/Client/Bin/ShaderFiles/
!/Client/Bin/ShaderFiles/**
!/Client/Bin/*.dds

# Required prebuilt third-party inputs.
!/Engine/ThirdPartyLib/*.lib
!/Engine/ThirdPartyLib/FMOD/Lib/fmod_vc.lib
!/Engine/ThirdPartyLib/FMOD/Bin/fmod.dll
!/Engine/ThirdPartyLib/Assimp/
!/Engine/ThirdPartyLib/Assimp/Bin/
!/Engine/ThirdPartyLib/Assimp/Bin/Debug/
!/Engine/ThirdPartyLib/Assimp/Bin/Debug/assimp-vc143-mtd.dll
!/Engine/ThirdPartyLib/Assimp/Bin/Release/
!/Engine/ThirdPartyLib/Assimp/Bin/Release/assimp-vc143-mt.dll

# Do not retain bundled viewer/runtime binaries inside resource folders.
/Client/Bin/Resources/**/*.exe
/Client/Bin/Resources/**/*.dll
/Client/Bin/Resources/**/*.pdb

# Local tool state
[Ii]mgui.ini
*.tmp
*.bak
*.orig

# Shared Winters asset converter bundle. Runtime resources remain Drive-managed.
!/Tools/
!/Tools/WintersAssetConverter/
!/Tools/WintersAssetConverter/**
