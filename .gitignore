# Visual Studio user state
.vs/
**/.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.VC.db
*.VC.VC.opendb

# Build and intermediate directories
/x64/
/x86/
**/x64/
**/x86/
**/[Dd]ebug/
**/[Rr]elease/
**/[Oo]bj/
**/ipch/

# Compiler, linker, and debugger outputs
*.obj
*.iobj
*.ipdb
*.pch
*.pdb
*.ilk
*.idb
*.exp
*.exe
*.dll
*.lib
*.tlog
*.lastbuildstate
*.recipe
*.FileListAbsolute.txt
*.CppClean.log
*.log

# Generated shader binaries
*.cso

# EngineSDK is regenerated by UpdateLib.bat.
/EngineSDK/

# Local extraction, cook, and generated workspaces
/_work/
/out/
/.codex_tmp/
/UmodelSaved/

# Cooked runtime resources are distributed through the shared Drive pack.
*.wmesh
*.wmat
*.wskel
*.wanim
*.wmodel

# Effect source search/export and curated cook output stay local or in the shared Drive.
/Data/Effects/Cooked/
/Data/Effects/SourceRaw/
/Data/Effects/SourceCatalog/
/Data/Effects/SourceExtracted/

# CHUDLayoutTool::Save() local safety-net copies (Backup_PreviousVersion) -- not a second
# authoring source, never restore from here as a substitute for committing.
/Data/UI/**/.backups/

# Engine output directory: preserve shader source, ignore built binaries.
/Engine/Bin/*
!/Engine/Bin/ShaderFiles/
!/Engine/Bin/ShaderFiles/**

# Client runtime directory: Resources are shared through Drive by default.
# Feature PRs may force-add an exact dependency closure; already tracked files
# remain visible to Git even though unselected local pack contents stay ignored.
/Client/Bin/*
/Server/Bin/
/Client/Bin/Resources/
!/Client/Bin/DataFiles/
!/Client/Bin/DataFiles/**
# Effect Product reads Data/Effects/Authored directly. Runtime catalogs and
# hashed authored copies under Bin are retired generated artifacts.
/Client/Bin/DataFiles/Effect/
!/Client/Bin/ShaderFiles/
!/Client/Bin/ShaderFiles/**
!/Client/Bin/*.dds

# Required prebuilt third-party inputs.
!/Engine/ThirdPartyLib/*.lib
!/Engine/ThirdPartyLib/FMOD/Lib/fmod_vc.lib
!/Engine/ThirdPartyLib/FMOD/Bin/fmod.dll
!/Engine/ThirdPartyLib/Assimp/
!/Engine/ThirdPartyLib/Assimp/Bin/
!/Engine/ThirdPartyLib/Assimp/Bin/Debug/
!/Engine/ThirdPartyLib/Assimp/Bin/Debug/assimp-vc143-mtd.dll
!/Engine/ThirdPartyLib/Assimp/Bin/Release/
!/Engine/ThirdPartyLib/Assimp/Bin/Release/assimp-vc143-mt.dll
!/Engine/ThirdPartyLib/PhysX/
!/Engine/ThirdPartyLib/PhysX/Inc/
!/Engine/ThirdPartyLib/PhysX/Inc/**
!/Engine/ThirdPartyLib/PhysX/Lib/
!/Engine/ThirdPartyLib/PhysX/Lib/Debug/
!/Engine/ThirdPartyLib/PhysX/Lib/Debug/*.lib
!/Engine/ThirdPartyLib/PhysX/Lib/Release/
!/Engine/ThirdPartyLib/PhysX/Lib/Release/*.lib
!/Engine/ThirdPartyLib/PhysX/Bin/
!/Engine/ThirdPartyLib/PhysX/Bin/Debug/
!/Engine/ThirdPartyLib/PhysX/Bin/Debug/*.dll
!/Engine/ThirdPartyLib/PhysX/Bin/Release/
!/Engine/ThirdPartyLib/PhysX/Bin/Release/*.dll

# Do not retain bundled viewer/runtime binaries inside resource folders.
/Client/Bin/Resources/**/*.exe
/Client/Bin/Resources/**/*.dll
/Client/Bin/Resources/**/*.pdb

# Local tool state
[Ii]mgui.ini
__pycache__/
*.py[cod]
*.tmp
*.bak
*.orig

# Personal planning style override. Shared agents fall back when it is absent.
/.md/계획서작성규칙.local.md
/.md/GB/코드작성규칙.local.md
/.md/GB/계획서하네스규칙.local.md
/.md/GB/gotchas.local.md
/.md/local.gotchas.md
/.md/gotchas.local.md

# Shared Winters asset converter bundle. Runtime resources remain Drive-managed.
!/Tools/
!/Tools/ModelAssetConverter/
!/Tools/ModelAssetConverter/**

# The negation above re-includes everything under the converter, which brought
# back the interpreter cache that line 115 excludes for every other directory.
/Tools/ModelAssetConverter/**/__pycache__/

# Generated at the repository root by one-off extraction runs. These are
# reproducible outputs, not source.
/V5.*.generated.*.json
/CON
