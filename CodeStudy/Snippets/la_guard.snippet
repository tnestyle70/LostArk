<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>LostArk 입력 검사</Title>
      <Shortcut>la_guard</Shortcut>
      <Description>입력 검사와 명시적인 실패 반환</Description>
      <Author>LostArk</Author>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal><ID>purpose</ID><ToolTip>검사하는 입력과 반환 이유</ToolTip><Default>입력이 유효하지 않으면 반환한다.</Default></Literal>
        <Literal><ID>condition</ID><ToolTip>반환할 조건</ToolTip><Default>invalidInput</Default></Literal>
        <Literal><ID>result</ID><ToolTip>호출자에게 전달할 실패 값</ToolTip><Default>false</Default></Literal>
      </Declarations>
      <Code Language="CPP"><![CDATA[//$purpose$
if ($condition$)
{
    return $result$;
}

$end$]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
