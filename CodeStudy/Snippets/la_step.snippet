<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>LostArk 작업 블록</Title>
      <Shortcut>la_step</Shortcut>
      <Description>짧은 한국어 주석과 직접 작성할 처리 블록</Description>
      <Author>LostArk</Author>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal><ID>purpose</ID><ToolTip>처리 목적과 다음 소비자</ToolTip><Default>준비할 직업 목록에 중복 없이 추가</Default></Literal>
      </Declarations>
      <Code Language="CPP"><![CDATA[//$purpose$
$end$]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
