# Cooked W-format resources are distributed through the shared Drive pack by
# default. A feature PR may force-add its exact pull-reproducible dependency
# closure; those selected files remain ordinary tracked Git inputs.

# Map source documents under Data/Maps and published runtime snapshots grow to multiple MB per shard.
*.mapset filter=lfs diff=lfs merge=lfs -text
*.mapassets filter=lfs diff=lfs merge=lfs -text
*.mapplacements filter=lfs diff=lfs merge=lfs -text

# Audio assets
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text

# Required prebuilt third-party binaries
*.lib filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text

# Shared asset converter executable
/Tools/ModelAssetConverter/Bin/*.exe filter=lfs diff=lfs merge=lfs -text


# Python extractor scripts must stay LF regardless of local core.autocrlf: their SHA-256 is
# pinned inside Data/Balance/Reference/Official/*.receipt.json, and a CRLF checkout changes
# the hash and fails Publish-GameplayBalance.ps1's staleness check.
*.py text eol=lf

# Representative-four V1 admission seals the raw V0 document bytes.  Preserve
# the historical mixed line endings explicitly so a fresh checkout cannot
# silently invalidate those five source identities.  The materializer emits
# every V1 document and its receipt as canonical LF.
/Data/Effects/Authored/effect.dimensionmaster.skill.2050180.unified.effect.json text eol=lf
/Data/Effects/Authored/effect.artist.skill.31460.unified.effect.json text eol=crlf
/Data/Effects/Authored/effect.lancemaster.skill.34110.unified.effect.json text eol=crlf
/Data/Effects/Authored/effect.warlord.skill.17110.clip2.unified.effect.json text eol=lf
/Data/Effects/Authored/effect.warlord.skill.17110.clip3.unified.effect.json text eol=lf
/Data/Effects/Authored/effect.dimensionmaster.skill.2050180.v1.unified.effect.json text eol=lf
/Data/Effects/Authored/effect.artist.skill.31460.v1.unified.effect.json text eol=lf
/Data/Effects/Authored/effect.lancemaster.skill.34110.v1.unified.effect.json text eol=lf
/Data/Effects/Authored/effect.warlord.skill.17110.clip2.v1.unified.effect.json text eol=lf
