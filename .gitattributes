# Binary assets intentionally tracked outside the Drive-managed runtime resource root
*.fbx filter=lfs diff=lfs merge=lfs -text
*.FBX filter=lfs diff=lfs merge=lfs -text
*.dds filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.bmp filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.spritefont filter=lfs diff=lfs merge=lfs -text
*.dat filter=lfs diff=lfs merge=lfs -text

# Cooked W-format resources are distributed through the shared Drive pack.
# They are ignored by .gitignore instead of being stored in Git LFS.

# Map source documents under Data/Maps and published runtime snapshots grow to multiple MB per shard.
*.mapset filter=lfs diff=lfs merge=lfs -text
*.mapassets filter=lfs diff=lfs merge=lfs -text
*.mapplacements filter=lfs diff=lfs merge=lfs -text

# Audio assets
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text

# Required prebuilt third-party binaries
*.lib filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text

# Shared asset converter executable
/Tools/ModelAssetConverter/Bin/*.exe filter=lfs diff=lfs merge=lfs -text


# Python extractor scripts must stay LF regardless of local core.autocrlf: their SHA-256 is
# pinned inside Data/Balance/Reference/Official/*.receipt.json, and a CRLF checkout changes
# the hash and fails Publish-GameplayBalance.ps1's staleness check.
*.py text eol=lf

# The Artist 31470 reconstructed runtime program has a frozen raw UTF-8/LF
# identity. Keep this one generated candidate byte-exact on every checkout.
/Data/Effects/Imported/Artist/Candidates/skill.31470.reconstructed-runtime-program.candidate.json text eol=lf

# The Artist 31470 Material render-resource approval is raw-byte frozen and
# must survive core.autocrlf=true clean checkouts without CRLF conversion.
/Data/Effects/Imported/Artist/Materials/skill.31470.material-render-resource-binding-approved-v1.receipt.json text eol=lf

# The Artist 31470 reconstructed render-resource authority records exact DDS
# byte identities and must remain byte-stable in core.autocrlf=true checkouts.
/Data/Effects/Imported/Artist/Materials/skill.31470.reconstructed-render-resource-authority.receipt.json text eol=lf

# The generated Effect runtime Catalog is a raw-byte authority consumed by the
# exact old10/new13 harness. Keep its one trailing newline byte-exact on every
# checkout instead of allowing core.autocrlf to rewrite it.
/Client/Bin/DataFiles/Effect/EffectCatalog.runtime.json text eol=lf


