/Data/Animation/Authored/Valtan/Valtan.patterneffects.json text eol=crlf
/Data/Animation/Reference/Valtan/Valtan.clipseq text eol=lf
/Data/Encounters/Valtan/*.json text eol=lf
/Data/Effects/EffectCatalog.json text eol=lf
/Data/Effects/Authored/effect.valtan*.json text eol=lf
# The Whirlwind 420633 direct-authored Product predates the LF Valtan receipt
# chain and intentionally freezes its CRLF raw identity (e94ddf...). Preserve
